---
import { exclusiveSponsors } from '../data/partners';
import { partnerTiers } from '../data/site';
const exclusiveNames = new Set(exclusiveSponsors.map(p => p.name));
const supporters = [...new Set(partnerTiers.slice(0, 2).flatMap(tier => tier.partners))].filter(name => !exclusiveNames.has(name));
---
<div class="major-supporters" data-major-sponsors>
  <h3>Major tournament supporters</h3>
  <ul>{supporters.map(name => <li>{name}</li>)}</ul>
</div>
<style>
  .major-supporters{margin-block:2rem}h3{font-family:var(--font-display);font-size:1.2rem;margin-bottom:1rem}
  ul{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;list-style:none;padding:0}li{padding:1rem;border:1px solid var(--ink);font-size:.8rem;font-weight:800;line-height:1.6;background:var(--card);overflow-wrap:anywhere}
  @media(max-width:650px){ul{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
