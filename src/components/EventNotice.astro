---
import type { Event } from '../data/site';
import SMVenue from './SMVenue.astro';
interface Props { event: Event; }
const { event } = Astro.props;
---
{event.venuePending ? (
  <aside class="event-notice" aria-label={`${event.shortName} announcement`}>
    <p class="eyebrow">Chess United · Manila</p>
    <h3>{event.shortName}</h3>
    <p class="date">{event.dateLabel}</p>
    <p>Venue, time and entry details will be announced by the club.</p>
  </aside>
) : <SMVenue tournament />}
<style>
  .event-notice{padding:clamp(1.5rem,4vw,3rem);border:2px solid var(--ink);border-top:6px solid var(--azure);background:var(--ink);color:#fff;display:flex;flex-direction:column;justify-content:center;gap:1.25rem;min-height:260px;min-width:0}
  .eyebrow{color:var(--azure)}h3{font-family:var(--font-display);font-size:clamp(1.7rem,3vw,2.6rem);line-height:1.1;text-transform:uppercase}.date{font-size:1.1rem;font-weight:800}p{line-height:1.65}
</style>
