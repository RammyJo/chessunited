---
import { communityPartners } from '../data/site';
import PartnerLogoGrid from './PartnerLogoGrid.astro';
---

<div class="community-partners">
  <h3>Community partners</h3>
  <PartnerLogoGrid names={communityPartners} />
</div>

<style>
  .community-partners{margin-block:2rem}
  h3{font-family:var(--font-display);font-size:clamp(1.3rem,2.4vw,1.8rem);margin-bottom:1rem}
</style>
