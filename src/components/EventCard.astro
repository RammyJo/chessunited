---
import type { Event } from '../data/site';
import Icon from './Icon.astro';

export interface Props {
  event: Event;
}

const { event } = Astro.props;
---

<article class="event-card reveal">
  <time class="event-date" datetime={event.date} aria-label={`${event.dateLabel}, ${event.timeLabel}`}>
    <span class="day">{event.day}</span>
    <span class="month">{event.month}</span>
    <span class="year">{event.year}</span>
  </time>

  <div class="event-body">
    <p class="event-kicker">{event.kicker}</p>
    <h3 class="event-title">
      <a href={`/events/#${event.slug}`}>{event.name}</a>
    </h3>
    <ul class="event-meta">
      <li>
        <Icon name="clock" size={15} />
        <span>{event.timeLabel}</span>
      </li>
      <li>
        <Icon name="pin" size={15} />
        <span>{event.venueShort}</span>
      </li>
    </ul>
    <div class="event-foot">
      <p class="event-prize">
        <span>Top prize</span>
        {event.highlight}
      </p>
      <a class="text-link" href={`/events/#${event.slug}`} aria-label={`Details for ${event.name}`}>
        Details <Icon name="arrow" size={14} />
      </a>
    </div>
  </div>
</article>
