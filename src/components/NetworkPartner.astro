---
import { nucfp } from '../data/partners';
import { sponsors } from '../data/images';
import { mapsUrl, site } from '../data/site';
import Icon from './Icon.astro';
import { uploadedImages } from '../data/uploads';
const logo = sponsors.find(sponsor => sponsor.key === 'nucf')!;
---
<article class="network-partner" id="nucfp" data-network-partner>
  <img src={logo.src} srcset={logo.srcset} sizes="180px" width="600" height="450" alt={logo.alt} loading="lazy" decoding="async" />
  <div>
    <p class="eyebrow">{nucfp.role} · {nucfp.city}</p>
    <h2>Chess United × NUCFP</h2>
    <p>A home for learning, training and community chess in NCR.</p>
    <address><strong>{nucfp.name}</strong><br />{nucfp.address}<span>{nucfp.access}</span></address>
    <div class="hero-actions">
      <a class="text-link" href={mapsUrl(nucfp.mapsQuery)} target="_blank" rel="noopener noreferrer">Find the centre <Icon name="pin" size={15} /></a>
      <a class="text-link" href={site.groupUrl} target="_blank" rel="noopener noreferrer">Club updates <Icon name="external" size={15} /></a>
    </div>
    <details class="centre-poster">
      <summary>Explore the NUCFP Center</summary>
      <a href={uploadedImages['nucfp-centre'].src} target="_blank" rel="noopener noreferrer" aria-label="View the full NUCFP Center opening poster">
        <img {...uploadedImages['nucfp-centre']} sizes="(max-width:650px) 80vw, 700px" loading="lazy" decoding="async" />
      </a>
    </details>
  </div>
</article>
<style>
  .network-partner{display:grid;grid-template-columns:180px minmax(0,1fr);align-items:center;gap:clamp(1.5rem,4vw,3rem);padding:clamp(1.25rem,4vw,3rem);border:2px solid var(--ink);background:#fff;scroll-margin-top:100px}
  img{width:100%;height:auto;object-fit:contain}
  h2{font-family:var(--font-display);font-size:clamp(1.45rem,3.2vw,2.5rem);line-height:1.2;margin-bottom:1rem}
  address{font-style:normal;line-height:1.65;margin-top:1rem;font-size:.9rem}address span{display:block;color:var(--muted);font-size:.8rem}
  .centre-poster{margin-top:1.5rem}summary{cursor:pointer;font-weight:800;font-size:.85rem;padding-block:.75rem;min-height:44px}.centre-poster img{display:block;width:100%;max-width:700px;margin-top:.75rem}
  @media(max-width:650px){.network-partner{grid-template-columns:minmax(0,1fr)}img{max-width:180px;margin-inline:auto}.hero-actions{gap:1.25rem}}
</style>
