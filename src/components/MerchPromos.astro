---
import Icon from './Icon.astro';
import { photos } from '../data/images';
---
<section class="section section--paper" id="merch" aria-labelledby="shop-title">
  <div class="wrap shop-teaser">
    <div class="shop-photo">
      <img src={photos.flatlay.src} srcset={photos.flatlay.srcset} sizes="(max-width:760px) 92vw, 42vw" width={photos.flatlay.width} height={photos.flatlay.height} alt={photos.flatlay.alt} loading="lazy" decoding="async" />
    </div>
    <div>
      <p class="eyebrow">Official club merchandise</p>
      <h2 id="shop-title" class="display-md">Take the club with you.</h2>
      <p class="lede">Shirts, chess gear and everyday essentials. Pay by GCash, with nationwide delivery or club pickup.</p>
      <div class="hero-actions">
        <a class="btn" href="/shop/#products">Shop merchandise <Icon name="cart" size={16} /></a>
        <a class="text-link" href="/membership/">Become a member <Icon name="arrow" size={15} /></a>
      </div>
    </div>
  </div>
</section>
<style>
  .shop-photo{max-height:420px;overflow:hidden}.shop-photo img{width:100%;height:100%;max-height:420px;object-fit:contain;background:#fff}
</style>
