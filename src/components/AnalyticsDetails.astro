eport .historical-detail summary{font-size:.75rem;font-weight:800;cursor:pointer;line-height:1.8}.analytics-report .audience-bar{display:flex;height:18px;background:var(--azure-tint);margin-top:1.5rem;border:1px solid var(--ink)}.analytics-report .audience-bar i{display:block;height:100%;min-width:0}.analytics-report [data-new-bar]{background:var(--azure)}.analytics-report [data-returning-bar]{background:var(--gold)}.analytics-report [data-unknown-bar]{background:#a0a8b5}.analytics-report .detail-note[data-error]{color:var(--red-ink)}@media(max-width:700px){.analytics-report .detail-grid{grid-template-columns:minmax(0,1fr)}.analytics-report .detail-wide{grid-column:auto}.analytics-report .detail-panel{padding:1rem}.analytics-report .detail-nav a{font-size:.65rem}.analytics-report .detail-panel th,.analytics-report .detail-panel td{font-size:.63rem;padding:.65rem .35rem}}
</style>
