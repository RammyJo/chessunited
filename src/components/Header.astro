---
import { site } from '../data/site';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const clean = href.replace(/\/+$/, '') || '/';
  return clean === '/' ? path === '/' : path === clean || path.startsWith(clean + '/');
};
---

<header class="site-header" data-header>
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img class="brand-logo" src="/images/logo.webp" width="560" height="560" alt="" />
      <span class="brand-text">
        <span class="brand-name">Chess United</span>
        <span class="brand-place">San Fernando · La Union</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Main">
      {site.nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <a class="btn btn--sm header-cta" href={site.groupUrl} target="_blank" rel="noopener">
      Join the group
      <Icon name="external" size={15} />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      data-menu-toggle
    >
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true" inert data-menu>
  <div class="mobile-menu-top">
    <a class="brand" href="/">
      <img class="brand-logo" src="/images/logo.webp" width="560" height="560" alt="" />
      <span class="brand-text">
        <span class="brand-name">Chess United</span>
        <span class="brand-place">San Fernando · La Union</span>
      </span>
    </a>
    <button class="menu-close" type="button" aria-label="Close menu" data-menu-close>
      <Icon name="close" size={22} />
    </button>
  </div>

  <nav class="mobile-nav" aria-label="Mobile">
    {site.nav.map((item, i) => (
      <a href={item.href} data-menu-link>
        <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        {item.label}
      </a>
    ))}
  </nav>

  <div class="mobile-menu-foot">
    <strong>Every Saturday · from 10 AM</strong>
    Robinsons Mall La Union · Rovers Coffee
    <a class="btn" href={site.groupUrl} target="_blank" rel="noopener">
      Join the Messenger group
      <Icon name="external" size={15} />
    </a>
  </div>
</div>
