---
import type { Photo } from '../data/images';
import Icon from './Icon.astro';

export interface Props {
  photos: Photo[];
  variant?: 'home' | 'full';
}

const { photos, variant = 'full' } = Astro.props as Props;
const eagerCount = variant === 'full' ? 1 : 0;

/* On the photo wall each frame is cut to the photograph inside it: portraits
   stand two rows tall, panoramics lie two columns wide, and the opening shot
   leads at both. One more photograph — the merch table — is given the same
   lead-sized frame so the wall has a second peak halfway down.

   The frame areas are chosen so the sixteen photographs always cover a whole
   number of rows at every breakpoint (4 + 4 + 14 × 2 = 36 cells, which divides
   by the 6, 3 and 2 column layouts). Any other mix leaves holes in the grid. */
const featureKey = 'flatlay';
const shape = (photo: Photo, index: number) => {
  if (variant !== 'full') return '';
  if (index === 0) return 'gallery-item--lead';
  if (photo.key === featureKey) return 'gallery-item--feature';
  if (photo.portrait) return 'gallery-item--tall';
  return 'gallery-item--wide';
};
---

<div class={`gallery-grid gallery-grid--${variant}`}>
  {photos.map((photo, index) => (
    <button
      class:list={['gallery-item', shape(photo, index)]}
      type="button"
      data-lightbox
      data-full={photo.full}
      data-alt={photo.alt}
      data-caption={photo.caption}
      aria-label={`Open larger photo: ${photo.caption}`}
    >
      <img
        src={photo.src}
        srcset={photo.srcset}
        sizes={
          variant === 'full'
            ? shape(photo, index) === 'gallery-item--tall'
              ? '(max-width: 520px) 46vw, (max-width: 900px) 23vw, 14vw'
              : '(max-width: 520px) 96vw, (max-width: 900px) 47vw, 29vw'
            : '(max-width: 760px) 46vw, 33vw'
        }
        width={photo.width}
        height={photo.height}
        alt={photo.alt}
        loading={index < eagerCount ? 'eager' : 'lazy'}
        fetchpriority={variant === 'full' ? (index === 0 ? 'high' : 'low') : undefined}
        decoding="async"
      />
      <span class="gallery-cap" aria-hidden="true">{photo.caption}</span>
    </button>
  ))}
</div>

<dialog class="lightbox" data-lightbox-dialog aria-label="Photo viewer">
  <div class="lightbox-inner">
    <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close photo viewer">
      <Icon name="close" size={20} />
    </button>
    <img data-lightbox-img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" width="1200" height="630" alt="" />
    <div class="lightbox-bar">
      <p class="lightbox-caption" data-lightbox-caption></p>
      <div class="lightbox-controls">
        <button class="lightbox-nav" type="button" data-lightbox-prev aria-label="Previous photo">
          <Icon name="prev" size={20} />
        </button>
        <button class="lightbox-nav" type="button" data-lightbox-next aria-label="Next photo">
          <Icon name="next" size={20} />
        </button>
      </div>
    </div>
  </div>
</dialog>
