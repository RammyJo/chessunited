---
import { coachingVisit, eventPath } from '../data/event-archive';
import { eventPhase } from '../lib/event-dates.mjs';
import Icon from './Icon.astro';
---
{eventPhase(coachingVisit) === 'present' && <aside class="coach-visit" data-current-event data-event-end={coachingVisit.endDate}>
  {coachingVisit.profileImage && <a class="coach-image" href={eventPath(coachingVisit)} aria-label="See Coach Henry’s visit details"><img {...coachingVisit.profileImage} sizes="(max-width:760px) 90vw, 600px" loading="lazy" decoding="async" /></a>}
  <div class="coach-copy"><p class="eyebrow">Youth coaching · 28–29 November 2026</p><h3>Coach Henry is coming to La Union.</h3><p>Visiting from Rizal to coach Chess United kids and teens. Session time and venue to be announced.</p>
  <a class="btn btn--ghost" href={eventPath(coachingVisit)}>Visit updates <Icon name="arrow" size={16} /></a></div>
</aside>}
<style>
  .coach-visit{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);align-items:center;gap:clamp(1.25rem,3vw,2rem);padding:clamp(1.25rem,3vw,2rem);border:2px solid var(--ink);border-left:7px solid var(--azure);background:#fff;margin-bottom:2rem}
  .coach-image{display:block;min-width:0}.coach-image img{display:block;width:100%;height:auto}
  .coach-copy{min-width:0}.coach-copy .btn{margin-top:1.25rem}
  h3{font-family:var(--font-display);font-size:clamp(1.2rem,2.4vw,1.8rem);line-height:1.25;margin-block:.65rem}p{font-size:.9rem;line-height:1.7}
  @media(max-width:760px){.coach-visit{grid-template-columns:1fr}}
</style>
