---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import ExclusiveSponsors from '../components/ExclusiveSponsors.astro';
import ArchiveEventCard from '../components/ArchiveEventCard.astro';
import CoachingVisit from '../components/CoachingVisit.astro';
import MajorSponsors from '../components/MajorSponsors.astro';
import { homeEvents } from '../data/event-archive';
import { scriptUrl } from '../lib/assets';
import AddToCalendar from '../components/AddToCalendar.astro';
import MerchPromos from '../components/MerchPromos.astro';
import HighlightVideo from '../components/HighlightVideo.astro';
import { highlightVideo } from '../data/highlights';
import { site, upcomingEvents, saturdayEvent, saturdayJsonLd } from '../data/site';
import NetworkPartner from '../components/NetworkPartner.astro';
import { heroImage } from '../data/images';
import { smLogo } from '../data/partners';

const origin = Astro.site ?? new URL('https://chessunitedglobal.com');
const abs = (path: string) => new URL(path, origin).href;

const clubJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  '@id': abs('/#club'),
  name: site.name,
  url: abs('/'),
  logo: abs('/images/icon-512.png'),
  image: abs('/images/og.jpg'),
  description: site.description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'San Fernando City',
    addressRegion: 'La Union',
    addressCountry: 'PH',
  },
  areaServed: {
    '@type': 'City',
    name: 'San Fernando City, La Union',
  },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': abs('/#website'),
  url: abs('/'),
  name: site.name,
  description: site.description,
  inLanguage: 'en-PH',
  publisher: { '@id': abs('/#club') },
};

const eventJsonLd = upcomingEvents.map((event) => ({
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: event.name,
  description: event.note ?? `${event.name} at ${event.venue}.`,
  startDate: event.detailsPending ? event.date : `${event.date}T${event.start}:00+08:00`,
  endDate: event.detailsPending ? undefined : `${event.date}T${event.end}:00+08:00`,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  url: abs(`/events/#${event.slug}`),
  image: abs(event.poster ?? '/images/og.jpg'),
  location: {
    '@type': event.venuePending ? 'City' : 'Place',
    name: event.venuePending ? event.city : event.venue,
    address: {
      '@type': 'PostalAddress',
      streetAddress: event.address,
      addressLocality: event.city ?? 'San Fernando City',
      addressRegion: event.region ?? 'La Union',
      addressCountry: 'PH',
    },
  },
  organizer: { '@type': 'Organization', name: site.name, url: abs('/') },
  offers: event.detailsPending ? undefined : event.divisions.map((division) => ({
    '@type': 'Offer',
    name: division.name,
    price: division.fee,
    priceCurrency: 'PHP',
    url: abs(`/events/#${event.slug}`),
  })),
}));

const highlightJsonLd = highlightVideo ? [{
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Chess United highlights',
  description: 'One minute of focus, competition and community from a past Chess United event.',
  thumbnailUrl: abs(highlightVideo.poster),
  contentUrl: abs(highlightVideo.src),
  uploadDate: '2026-11-13',
  duration: 'PT1M',
  url: abs('/#highlights'),
}] : [];

---

<Base
  title="Chess United — chess for everyone in San Fernando, La Union"
  description={site.description}
  jsonLd={[clubJsonLd, websiteJsonLd, saturdayJsonLd(origin.href), ...eventJsonLd, ...highlightJsonLd]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    imagesrcset={heroImage.srcset}
    imagesizes="(max-width: 980px) 92vw, 46vw"
  />

  <Header />

  <main id="main">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">San Fernando City · La Union</p>
          <div class="chess-signature"><img src="/images/knight-mark.svg" width="52" height="52" alt="" /><span>Your next move<br /><strong>starts here.</strong></span></div>
          <h1 class="hero-title display-xl">
            <span class="line">Chess</span>
            <span class="line">for</span>
            <span class="line"><span class="mark">everyone.</span></span>
          </h1>
          <p class="hero-lede">
            A community chess club for kids, teens and adults in San Fernando. Pull up a chair
            on Saturday, or test your game on tournament day.
          </p>
          <div class="hero-sm">
            <span>Now playing at</span>
            <img {...smLogo} sizes="(max-width:650px) 80vw, 380px" alt="SM City La Union" decoding="async" />
          </div>
          <div class="hero-actions">
            <a class="btn" href="/visit/">
              Join Saturday chess
              <Icon name="arrow" size={17} class="arrow" />
            </a>
            {highlightVideo ? (
              <a class="btn btn--ghost" href="#highlights" data-highlight-jump><Icon name="youtube" size={18} /> Watch the highlights</a>
            ) : (
              <a class="btn btn--ghost" href="/events/">See the tournaments</a>
            )}
          </div>
          <ul class="hero-facts">
            <li><Icon name="check" size={15} /> All ages &amp; beginners</li>
            <li><Icon name="check" size={15} /> Weekly in the mall</li>
          </ul>
        </div>

        <div class="hero-visual">
          <div class="hero-frame">
            <picture>
              <source srcset={heroImage.srcset} sizes="(max-width: 980px) 92vw, 46vw" type="image/webp" />
              <img
                src={heroImage.jpg}
                width={heroImage.width}
                height={heroImage.height}
                alt={heroImage.alt}
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
          <div class="hero-sticker" aria-hidden="true">
            <strong>Every<br />Saturday</strong>
            <small>SM City La Union · 10 AM</small>
          </div>
          <a class="hero-ticket" href="/events/#saturday-chess">
            <span class="hero-ticket-date">
              <strong>SAT</strong>
              <span>WEEKLY</span>
            </span>
            <span class="hero-ticket-body">
              <small>Next up</small>
              <strong>Saturday chess</strong>
              <span>SM City La Union · 10 AM–2 PM →</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    {highlightVideo && <HighlightVideo {...highlightVideo} />}

    <section class="section" aria-labelledby="next-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">On the board</p>
            <h2 id="next-title">Next up.</h2>
          </div>
          <p class="lede">
            Tournaments across Elyu, with every event kept in the permanent archive.
          </p>
        </div>

        <CoachingVisit />
        <div class="home-event-grid" data-current-list>
          {homeEvents.map((event) => <ArchiveEventCard event={event} />)}
        </div>
        <p data-current-empty hidden>See the event archive for the latest tournaments.</p>
        <div class="hero-actions"><a class="btn btn--ghost" href="/events/">All events <Icon name="arrow" size={16} /></a></div>

        <div class="countdown-row reveal">
          <p class="countdown-label">
            Weekly community chess
            <strong>SM City La Union · Saturdays, 10 AM–2 PM</strong>
          </p>
          <AddToCalendar event={saturdayEvent} link={abs('/events/#saturday-chess')} />
        </div>
      </div>
    </section>

    <section class="section section--paper" aria-label="Strategic partnership">
      <div class="wrap"><NetworkPartner /></div>
    </section>

    <MerchPromos />

    <section class="section--tight" aria-labelledby="partners-title">
      <div class="wrap">
        <div class="section-head">
          <div><p class="eyebrow">Backed by the community</p><h2 id="partners-title">Our partners.</h2></div>
          <a class="btn btn--ghost" href="/about/#partners">All partners &amp; sponsors <Icon name="arrow" size={16} /></a>
        </div>
        <ExclusiveSponsors compact />
        <MajorSponsors />
      </div>
    </section>
    <section class="home-archive" aria-labelledby="archive-title">
      <div class="wrap home-archive-inner">
        <div><h2 id="archive-title">From the archives.</h2><p>Past tournaments, original posters and published results.</p></div>
        <a class="btn btn--ghost btn--sm" href="/events/#past-events">Browse archives <Icon name="arrow" size={15} /></a>
      </div>
    </section>
  </main>

  <Footer />
  <script is:inline type="module" src={scriptUrl('event-archive.js')}></script>
</Base>

<style>
  .home-archive{padding-block:2rem;border-top:1px solid rgba(10,21,51,.18)}.home-archive-inner{display:flex;justify-content:space-between;align-items:center;gap:1.25rem;flex-wrap:wrap}.home-archive h2{font-family:var(--font-display);font-size:1.15rem;line-height:1.4}.home-archive p{font-size:.85rem;color:var(--muted);line-height:1.6;margin-top:.4rem}.home-archive .btn{min-height:44px;box-shadow:none}
  .home-event-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}
  @media(max-width:650px){.home-event-grid{grid-template-columns:1fr}}
  .hero-sm{display:flex;flex-direction:column;gap:.65rem;margin-block:1.5rem;max-width:420px;background:#fff;padding:1rem;align-items:center}
  .hero-sm span{font-size:.65rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  .hero-sm img{width:100%;height:auto;object-fit:contain}
</style>
