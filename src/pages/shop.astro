---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, merch, couriers, formatPeso } from '../data/site';
import { photos, merchPhotos } from '../data/images';

const origin = Astro.site ?? new URL('https://chessunitedglobal.com');
const abs = (path: string) => new URL(path, origin).href;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Merchandise', item: abs('/shop/') },
  ],
};

/* Product photos are declared in src/data/images.ts next to every other image on
   the site. A product without an entry keeps the card's placeholder tile, so the
   club can publish photos one at a time and the page never ships a broken image. */
const photoFor = (id: string) => merchPhotos[id] ?? null;

type Product = {
  id: string;
  name: string;
  price: number;
  note?: string;
  sizes?: string[];
  group: string;
  photo: string | null;
};

const groups = merch.map((group) => ({
  name: group.name,
  blurb: group.blurb,
  items: group.items.map((item): Product => ({
    ...item,
    group: group.name,
    photo: photoFor(item.id),
  })),
}));

const products: Product[] = groups.flatMap((group) => group.items);
const missingPhotos = products.filter((item) => !item.photo).length;

/* What a courier costs is added to the order automatically as soon as the club
   publishes the amount. Until then the page says the club quotes it, because a
   guessed shipping fee on a live shop is worse than none. The numbers that
   actually price an order live in functions/api/_catalog.js. */
const feeLabel = (fee: number | null) =>
  fee === null ? 'shipping quoted by the club' : `${formatPeso(fee)} shipping`;

/* Held as a string so Astro does not read `{{…}}` in markup as a JS expression.
   forms.js fills these tokens from the JSON the API returns. */
const orderTemplate = `
  <h3>Order received.</h3>
  <p>Your order number is</p>
  <p class="success-code">{{order.orderNo}}</p>
  <p>Shipping to {{order.shipTo}} by {{order.courier}}.</p>
  <p>
    A club officer checks the order, confirms the total by email, then packs and sends
    the parcel. Nothing ships before the payment lands in the club account.
  </p>
`;
---

<Base
  title="Official merchandise — Chess United"
  description="Shop Chess United merch online — shirts, caps, chess sets and clocks. Pick a size, add to cart, pay by GCash, delivered nationwide by LBC or J&T Express."
  jsonLd={breadcrumbJsonLd}
>
  <Header />

  <main id="main">
    <header class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Official club merchandise</p>
        <h1>Shop the club.</h1>
        <p class="lede">
          From the board to the bag: Chess United shirts, sets, clocks and small things. Add what
          you want to the cart, tell the club where to send it, and pay by GCash — delivered
          anywhere in the Philippines by LBC or J&amp;T Express.
        </p>
        <div class="page-hero-meta">
          <span><Icon name="cart" size={15} /> {products.length} products</span>
          <span><Icon name="check" size={15} /> Pay by GCash</span>
          <span><Icon name="pin" size={15} /> Nationwide delivery</span>
        </div>
      </div>
    </header>

    <section class="section section--paper" id="prices" aria-labelledby="price-title">
      <div class="wrap shop-teaser">
        <div class="shop-photo reveal">
          <img
            src="/images/posters/merch-price-list-900.webp"
            width="900"
            height="636"
            alt="Chess United official merchandise price list poster with shirts, chess sets, clocks and small items."
            loading="lazy"
            decoding="async"
          />
          <span class="tag">Official price list</span>
        </div>
        <div>
          <p class="eyebrow">The list</p>
          <h2 id="price-title" class="display-md">Support the club. Look the part.</h2>
          <p class="lede">
            Every price in the catalogue below is reproduced from the club's own merchandise poster.
            The poster advertises limited stocks, so the club confirms availability when it receives
            your order.
          </p>
          <div class="note-box mt-2">
            <strong>How pricing works:</strong> the club charges its published list price for the
            items. The courier fee is added to the order automatically once the club publishes what
            each courier costs.
          </div>
          <div class="hero-actions">
            <a class="btn" href="#products">
              <Icon name="cart" size={15} /> See the catalogue
            </a>
            <a class="btn btn--ghost" href={site.groupUrl} target="_blank" rel="noopener">
              Ask the club <Icon name="external" size={15} />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="jersey-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Tournament day</p>
            <h2 id="jersey-title" class="display-md">The club jersey.</h2>
          </div>
          <p class="lede">
            White body, blue and red raglan sleeves, the crest on the chest and the knight on the
            back — the sublimation design the club publishes for tournament wear.
          </p>
        </div>

        <div class="shop-photo shop-photo--wide reveal">
          <img
            src={photos.jersey.src}
            srcset={photos.jersey.srcset}
            sizes="(max-width: 900px) 92vw, 70vw"
            width={photos.jersey.width}
            height={photos.jersey.height}
            alt={photos.jersey.alt}
            loading="lazy"
            decoding="async"
          />
          <span class="tag">Sublimation jersey design</span>
        </div>

        <div class="jersey-facts">
          <div class="price-list">
            <div class="price-row">
              <span class="name">Sublimation shirt</span>
              <span class="dots" aria-hidden="true"></span>
              <span class="amount">₱600</span>
            </div>
            <div class="price-row">
              <span class="name">T-shirt</span>
              <span class="dots" aria-hidden="true"></span>
              <span class="amount">₱300</span>
            </div>
            <div class="price-row">
              <span class="name">Polo shirt</span>
              <span class="dots" aria-hidden="true"></span>
              <span class="amount">₱400</span>
            </div>
          </div>
          <div class="note-box">
            <strong>Personalisation:</strong> the sample back carries a name and a number. The
            published list prices a sublimation shirt at ₱600 but does not say what personalisation
            costs, so put your name and number in the order notes and the club confirms the total.
          </div>
        </div>
      </div>
    </section>

    <section class="section section--paper" aria-labelledby="kit-title">
      <div class="wrap shop-teaser">
        <div>
          <p class="eyebrow">The kit in real life</p>
          <h2 id="kit-title" class="display-md">Shirt, cap, mug, notebook.</h2>
          <p class="lede">
            The club's printed range is worn at the tables, not kept in a box. Everything in this
            picture is in the catalogue below — add it to the cart and the club sends it out.
          </p>
          <div class="badge-row mt-2">
            <span class="badge">Order online</span>
            <span class="badge">Limited stocks</span>
            <span class="badge">Club colours</span>
          </div>
        </div>

        <div class="shop-photo shop-photo--portrait reveal">
          <img
            src={photos.merchlife.src}
            srcset={photos.merchlife.srcset}
            sizes="(max-width: 900px) 92vw, 42vw"
            width={photos.merchlife.width}
            height={photos.merchlife.height}
            alt={photos.merchlife.alt}
            loading="lazy"
            decoding="async"
          />
          <span class="tag">Club merchandise</span>
        </div>
      </div>
    </section>

    <section class="section" id="products" aria-labelledby="products-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">The catalogue</p>
            <h2 id="products-title">Pick your kit.</h2>
          </div>
          <p class="lede">
            Choose a size where there is one, set a quantity, add it to the cart — and the cart keeps
            it, even if you close the page. The order form opens once the cart has something in it.
          </p>
        </div>

        {groups.map((group) => (
          <div class="product-category">
            <div class="product-category-head">
              <h3>{group.name}</h3>
              <span>{group.items.length} products</span>
            </div>
            <p class="product-category-blurb">{group.blurb}</p>

            <div class="product-grid">
              {group.items.map((item) => (
                <article
                  class="product-card"
                  data-product
                  data-product-id={item.id}
                  data-product-name={item.name}
                  data-product-price={item.price}
                  data-product-sizes={item.sizes?.join(',') ?? undefined}
                >
                  <div class="product-media">
                    {item.photo ? (
                      <img
                        src={item.photo}
                        width="600"
                        height="600"
                        alt={`${item.name} — Chess United merchandise`}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="product-placeholder">
                        <Icon name="spark" size={28} />
                        <span>{item.name}</span>
                        <small>Photo coming</small>
                      </div>
                    )}
                  </div>

                  <h4 class="product-name">{item.name}</h4>
                  <p class="product-note">{item.note || ' '}</p>
                  <p class="product-price">{formatPeso(item.price)}</p>

                  {item.sizes && item.sizes.length > 0 && (
                    <div class="product-sizes" role="group" aria-labelledby={`sizes-${item.id}-label`}>
                      <span class="product-sizes-label" id={`sizes-${item.id}-label`}>Size</span>
                      <div class="product-size-choices">
                        {item.sizes.map((size) => (
                          <>
                            <input
                              class="product-size-input"
                              type="radio"
                              id={`size-${item.id}-${size}`}
                              name={`size-${item.id}`}
                              value={size}
                              data-product-size={item.id}
                            />
                            <label class="product-size-chip" for={`size-${item.id}-${size}`}>{size}</label>
                          </>
                        ))}
                      </div>
                    </div>
                  )}

                  <div class="product-buy">
                    <label class="product-qty-label" for={`qty-${item.id}`}>
                      Qty<span class="sr-only"> of {item.name}</span>
                    </label>
                    <input
                      class="product-qty"
                      id={`qty-${item.id}`}
                      type="number"
                      min="1"
                      max="99"
                      step="1"
                      value="1"
                      inputmode="numeric"
                      data-product-qty={item.id}
                    />
                    <button class="btn btn--sm product-add" type="button" data-add-to-cart={item.id}>
                      Add to cart
                    </button>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}

        {missingPhotos > 0 && (
          <p class="merch-note">
            {missingPhotos} of {products.length} products are still waiting for their photo. The
            price and the order line are already correct — the picture appears as soon as the club
            sends it.
          </p>
        )}
      </div>
    </section>

    <section class="section section--paper" id="order" aria-labelledby="order-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Checkout</p>
            <h2 id="order-title">Send your order.</h2>
          </div>
          <p class="lede">
            Open your cart and select Checkout. Enter your delivery address, choose the courier
            and pay by GCash — a club officer checks the payment before the parcel leaves.
          </p>
        </div>

        <noscript>
          <p class="note-box">
            <strong>No JavaScript:</strong> the cart and the live total need it. Turn it on to order
            from this page, or send the club a message with the items, sizes and quantities you want
            and the order will be taken the same way —
            <a href={site.groupUrl} target="_blank" rel="noopener">in the club group</a>.
          </p>
        </noscript>

        <p class="cart-locked" data-checkout-empty>
          <Icon name="cart" size={16} />
          <span>Add items from the catalogue, then select Checkout from your cart.</span>
        </p>

        <div data-form-shell>
          <form class="form-card" data-api="/api/orders" hidden data-checkout-form>
            <h3>Merchandise order</h3>

            <div class="cart-review">
              <div class="cart-review-head">
                <strong>Your cart</strong>
                <button class="text-link" type="button" aria-expanded="false" aria-controls="cart-drawer" data-cart-open>Change it</button>
              </div>
              <ul class="cart-review-lines" data-cart-summary></ul>
              <p class="cart-review-total">
                <strong>Items subtotal</strong>
                <span class="amount" data-subtotal>₱0</span>
              </p>
              <dl class="cart-review-fees">
                <div>
                  <dt>Shipping</dt>
                  <dd class="amount" data-cart-shipping>Quoted by the club</dd>
                </div>
                <div class="cart-review-fees--total">
                  <dt>Total</dt>
                  <dd class="amount" data-cart-grand>₱0</dd>
                </div>
              </dl>
              <p class="cart-review-note" data-cart-shipping-note>
                The club adds the courier fee for the parcel and confirms the total before you pay.
              </p>
            </div>

            {/* cart.js writes one field per cart line into this block — product,
                size and quantity. forms.js turns them into the items array that the
                API re-prices on the server, so nothing the browser holds can change
                what a buyer is charged. */}
            <div data-order-lines hidden></div>

            <p class="field-error" data-error-for="items" hidden></p>

            <h3 class="mt-3">Where it ships</h3>

            <div class="form-grid">
              <div class="field">
                <label for="o-name">Full name</label>
                <input id="o-name" name="fullName" required minlength="3" maxlength="120" autocomplete="name" />
                <p class="field-error" data-error-for="fullName" hidden></p>
              </div>

              <div class="field">
                <label for="o-email">Email</label>
                <input id="o-email" name="email" type="email" required autocomplete="email" />
                <p class="field-error" data-error-for="email" hidden></p>
              </div>

              <div class="field">
                <label for="o-phone">Mobile number</label>
                <input id="o-phone" name="phone" required inputmode="tel" placeholder="09171234567" autocomplete="tel" />
                <p class="field-error" data-error-for="phone" hidden></p>
              </div>

              <div class="field">
                <label for="o-country">Country</label>
                <input id="o-country" name="country" value="Philippines" maxlength="80" autocomplete="country-name" />
              </div>

              <div class="field field--wide">
                <label for="o-address">Street address</label>
                <input id="o-address" name="address" required minlength="8" maxlength="240" autocomplete="street-address" />
                <p class="field-error" data-error-for="address" hidden></p>
              </div>

              <div class="field">
                <label for="o-city">City or municipality</label>
                <input id="o-city" name="city" required minlength="2" maxlength="80" autocomplete="address-level2" />
                <p class="field-error" data-error-for="city" hidden></p>
              </div>

              <div class="field">
                <label for="o-province">Province or state</label>
                <input id="o-province" name="province" required minlength="2" maxlength="80" autocomplete="address-level1" />
                <p class="field-error" data-error-for="province" hidden></p>
              </div>

              <div class="field">
                <label for="o-postcode">Postal code <span class="hint">optional</span></label>
                <input id="o-postcode" name="postcode" maxlength="16" autocomplete="postal-code" />
              </div>

              <div class="field">
                <label for="o-courier">Courier</label>
                <select id="o-courier" name="courier" required data-courier-select>
                  {couriers.map((courier) => (
                    <option value={courier.id} data-courier-fee={courier.fee ?? undefined}>
                      {courier.label} — {courier.note} · {feeLabel(courier.fee)}
                    </option>
                  ))}
                </select>
                <p class="field-error" data-error-for="courier" hidden></p>
              </div>

              <div class="field field--wide">
                <label for="o-notes">Order notes <span class="hint">optional</span></label>
                <textarea id="o-notes" name="notes" maxlength="400" placeholder="Name and number for the back of a jersey, colours, or anything else the club should know."></textarea>
              </div>
            </div>

            <div class="pay-box mt-3">
              <strong>Paying by GCash</strong>
              <ol>
                <li>Send the order first — the club emails you the total, items plus the courier fee.</li>
                <li>Scan the club's GCash QR and pay that amount.</li>
                <li>Nothing ships until the payment lands in the club account.</li>
              </ol>
            </div>

            <p class="form-status" data-form-status hidden></p>

            <div class="form-actions">
              <button class="btn" type="submit" data-busy="Sending…">
                <Icon name="check" size={16} /> Send my order
              </button>
              <a class="btn btn--ghost" href="#products">Back to the catalogue</a>
            </div>

            <p class="hint mt-2">
              No card details are ever taken on this site. The club only ever sees what you type
              here.
            </p>
          </form>

          <div class="form-success" data-success hidden>
            <template data-success-template set:html={orderTemplate}></template>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="idkit-title">
      <div class="wrap shop-teaser">
        <div class="shop-photo shop-photo--portrait reveal">
          <img
            src={photos.lanyard.src}
            srcset={photos.lanyard.srcset}
            sizes="(max-width: 900px) 92vw, 42vw"
            width={photos.lanyard.width}
            height={photos.lanyard.height}
            alt={photos.lanyard.alt}
            loading="lazy"
            decoding="async"
          />
          <span class="tag">Club ID kit</span>
        </div>
        <div>
          <p class="eyebrow">Lanyard &amp; member ID</p>
          <h2 id="idkit-title" class="display-md">Two hundred pesos, and you're on the roster.</h2>
          <p class="lede">
            Register as a member and the digital card is free. The printed membership ID with the
            club lanyard — blue on one side, red on the other, the knight on the strap — is the
            club's ₱200 option, and it is ordered on the membership page.
          </p>
          <div class="price-list">
            <div class="price-row">
              <span class="name">Lanyard</span>
              <span class="dots" aria-hidden="true"></span>
              <span class="amount">₱100</span>
            </div>
            <div class="price-row">
              <span class="name">Member ID</span>
              <span class="dots" aria-hidden="true"></span>
              <span class="amount">₱100</span>
            </div>
          </div>
          <div class="hero-actions">
            <a class="btn" href="/membership/#register">
              Register and order an ID <Icon name="arrow" size={15} />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--paper" aria-labelledby="steps-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">How ordering works</p>
            <h2 id="steps-title">Cart, checkout, ship.</h2>
          </div>
          <p class="lede">
            Three steps, and the club handles the rest by hand.
          </p>
        </div>

        <div class="value-grid">
          <article class="value-card">
            <p class="value-num">01 / Cart</p>
            <h3>Add what you want.</h3>
            <p>
              Pick a size and a quantity on each product and add it to the cart. The cart stays with
              you, and you can change it any time before you send the order.
            </p>
          </article>
          <article class="value-card">
            <p class="value-num">02 / Checkout</p>
            <h3>Fill the form when you are ready.</h3>
            <p>
              The order form opens as soon as the cart holds something. Give the address, choose the
              courier, and the club confirms the total — items plus the courier fee — by email.
            </p>
          </article>
          <article class="value-card">
            <p class="value-num">03 / Ship</p>
            <h3>The club sends the parcel.</h3>
            <p>
              The club checks the payment in its GCash account, packs the order and sends it by LBC
              or J&amp;T Express anywhere in the Philippines.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="shop-cta">
      <div class="wrap cta-inner">
        <div>
          <h2 id="shop-cta" class="display-lg">Get the kit.</h2>
          <p>Order online and the club ships it to your door.</p>
        </div>
        <div class="cta-actions">
          <a class="btn" href="#products">
            <Icon name="cart" size={16} /> Back to the catalogue
          </a>
          <a class="btn btn--light" href="/visit/">Visit us</a>
        </div>
      </div>
    </section>
  </main>

  <div class="cart-scrim" data-cart-scrim hidden></div>

  <aside
    class="cart-drawer"
    id="cart-drawer"
    aria-labelledby="cart-drawer-title"
    aria-hidden="true"
    inert
    data-cart-drawer
  >
    <div class="cart-drawer-head">
      <h2 id="cart-drawer-title">Your cart</h2>
      <button class="cart-close" type="button" aria-label="Close cart" data-cart-close>
        <Icon name="close" size={20} />
      </button>
    </div>

    <p class="cart-empty" data-cart-empty>
      Nothing in the cart yet. Add something from the catalogue and it will wait for you here.
    </p>

    <ul class="cart-lines" data-cart-lines></ul>

    <div class="cart-foot">
      <p class="cart-total">
        <strong>Items subtotal</strong>
        <span class="amount" data-cart-total>₱0</span>
      </p>
      <p class="cart-hint">The courier fee is added by the club once it knows the destination.</p>
      <div class="cart-actions">
        <a class="btn" href="#order" data-cart-checkout>
          <Icon name="arrow" size={15} /> Checkout
        </a>
        <button class="btn btn--ghost" type="button" data-cart-clear>Empty cart</button>
      </div>
    </div>
  </aside>

  <p class="sr-only" data-cart-status aria-live="polite" aria-atomic="true"></p>

  <Footer />
</Base>
