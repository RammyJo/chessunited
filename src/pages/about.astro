---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, officerGroups, partnerTiers, globalHubs, globalNetworks, globalMarkers, team } from '../data/site';
import { photos, sponsors } from '../data/images';

const publishedOfficerGroups = officerGroups
  .map(group => ({ ...group, officers: group.officers.filter(person => !person.open) }))
  .filter(group => group.officers.length);

const origin = Astro.site ?? new URL('https://chessunitedglobal.com');
const abs = (path: string) => new URL(path, origin).href;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'About', item: abs('/about/') },
  ],
};

const initials = (name: string) =>
  name
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join('');

const sponsorHalf = Math.ceil(sponsors.length / 2);
const sponsorRows = [sponsors.slice(0, sponsorHalf), sponsors.slice(sponsorHalf)];
---

<Base
  title="About the club — Chess United"
  description="Meet Chess United: a San Fernando City, La Union club in the Chess United GLOBAL network — weekly Saturday chess and age-division tournaments."
  jsonLd={breadcrumbJsonLd}
>
  <Header />

  <main id="main">
    <header class="page-hero">
      <div class="wrap">
        <p class="eyebrow">The club</p>
        <h1>A club for the<br />whole board.</h1>
        <p class="lede">
          Chess United is a community chess club in San Fernando City, La Union. Weekly games in
          the mall, tournament days with real prizes, and a seat for every age.
        </p>
      </div>
    </header>

    <section class="section" aria-labelledby="story-title">
      <div class="wrap about-split">
        <div>
          <p class="eyebrow">The story</p>
          <h2 id="story-title" class="display-md">Chess, united.</h2>
          <div class="prose mt-2">
            <p>
              Chess United runs a weekly Saturday table at Robinsons Mall La Union and organises
              age-division tournaments with cash prizes. The first tournament, Tournament 1.0, was
              held at Rovers Coffee in October 2026; Tournament 2.0 followed at Robinsons Mall
              La Union on 7 November. Both events are now complete.
            </p>
            <p>
              The idea is in the name. Kids and adults, learning and competition, in the same
              room. The club's own tagline puts it plainly: <strong>chess for everyone.</strong>
            </p>
            <p>
              The weekly session is open to kids, teens and adults. The
              tournament divisions are split by age, and the club's community group is where
              players ask questions, arrange games and keep up with what's next.
            </p>
          </div>

          <div class="hero-actions">
            <a class="btn" href="/visit/#weekly">Join a Saturday</a>
            <a class="btn btn--ghost" href="/events/">See the tournaments</a>
          </div>
        </div>

        <figure class="about-photo reveal" style="margin:0">
          <img
            src={photos.medalist.src}
            srcset={photos.medalist.srcset}
            sizes="(max-width: 980px) 92vw, 46vw"
            width={photos.medalist.width}
            height={photos.medalist.height}
            alt={photos.medalist.alt}
            loading="lazy"
            decoding="async"
          />
          <figcaption class="caption">Tournament 1.0 · Rovers Coffee</figcaption>
        </figure>
      </div>
    </section>

    <section class="section section--paper" aria-labelledby="values-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">What we're about</p>
            <h2 id="values-title">Three things worth<br />showing up for.</h2>
          </div>
          <p class="lede">
            A club for anyone who wants more people at the board.
          </p>
        </div>

        <div class="value-grid">
          <article class="value-card reveal">
            <p class="value-num">01 / Everyone</p>
            <h3>Every age gets a board.</h3>
            <p>
              Kids, teens and adults play at the weekly session. Tournament play splits into
              Kiddies (12 &amp; below) and Open (13 &amp; above) so there is a fair bracket for
              both.
            </p>
          </article>
          <article class="value-card reveal">
            <p class="value-num">02 / In public</p>
            <h3>Chess in the middle of the mall.</h3>
            <p>
              The club plays where people can see it — Robinsons Mall La Union, every Saturday,
              10 AM to 2 PM. Curiosity is a good enough reason to stop by.
            </p>
          </article>
          <article class="value-card reveal">
            <p class="value-num">03 / Next generation</p>
            <h3>Young players get their own stage.</h3>
            <p>
              The Kiddies Division gives players 12 and under their own bracket, their own
              prizes and a real tournament experience.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--paper" aria-labelledby="global-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">One club, many boards</p>
            <h2 id="global-title">Chess United<br />GLOBAL.</h2>
          </div>
          <p class="lede">
            San Fernando City is where we play, but Chess United was never meant to stop at one
            table. The club is part of a worldwide network — regional networks across the
            Philippines and three headquarters covering the rest of the board.
          </p>
        </div>

        <div class="global-map reveal">
          <img
            src="/images/world-map.svg"
            width="1600"
            height="800"
            alt="World map with Chess United hubs marked in Vancouver, Bombay and San Fernando City, La Union"
            loading="eager"
            decoding="async"
          />
          <div class="map-marker map-marker--hq map-marker--left" style={`--mx:${globalMarkers['san-fernando'].x}%;--my:${globalMarkers['san-fernando'].y}%`}>
            <span class="map-dot" aria-hidden="true"></span>
            <span class="map-label">San Fernando · Asian HQ</span>
          </div>
          <div class="map-marker map-marker--hq" style={`--mx:${globalMarkers.vancouver.x}%;--my:${globalMarkers.vancouver.y}%`}>
            <span class="map-dot" aria-hidden="true"></span>
            <span class="map-label">Vancouver · North American HQ</span>
          </div>
          <div class="map-marker map-marker--hq" style={`--mx:${globalMarkers.bombay.x}%;--my:${globalMarkers.bombay.y}%`}>
            <span class="map-dot" aria-hidden="true"></span>
            <span class="map-label">Bombay · South Asian HQ</span>
          </div>
          <div class="map-marker map-marker--net map-marker--top-right" style={`--mx:${globalMarkers.luzon.x}%;--my:${globalMarkers.luzon.y}%`}>
            <span class="map-dot" aria-hidden="true"></span>
            <span class="map-label">CU Luzon</span>
          </div>
          <div class="map-marker map-marker--net map-marker--right" style={`--mx:${globalMarkers.visayas.x}%;--my:${globalMarkers.visayas.y}%`}>
            <span class="map-dot" aria-hidden="true"></span>
            <span class="map-label">CU Visayas</span>
          </div>
          <div class="map-marker map-marker--net map-marker--right-below" style={`--mx:${globalMarkers.mindanao.x}%;--my:${globalMarkers.mindanao.y}%`}>
            <span class="map-dot" aria-hidden="true"></span>
            <span class="map-label">CU Mindanao</span>
          </div>
        </div>

        <div class="hub-grid">
          {globalHubs.map((hub) => (
            <article class="hub-card reveal">
              <p class="hub-role">{hub.role}</p>
              <h3>{hub.location}</h3>
              <p>{hub.blurb}</p>
            </article>
          ))}
        </div>

        <div class="network-grid">
          {globalNetworks.map((net) => (
            <article class="network-card reveal">
              <h3>
                {net.name}
                <span class={`network-status network-status--${net.status}`}>
                  {net.status === 'active' ? 'Active' : 'Building'}
                </span>
              </h3>
              <p class="network-where">{net.where}</p>
              <p>{net.note}</p>
            </article>
          ))}
        </div>

        <p class="global-scope">
          The way the club counts its territory follows an old pattern: the city (Jerusalem), the
          province (Judea), the country (Samaria), and then the whole world — the scope in
          Acts&nbsp;1:8. Chess United started in San Fernando City and is working outward from
          there, one board at a time: <strong>that we might be a light to every city and nation
          where the game is played.</strong>
        </p>
      </div>
    </section>

    <section class="section" id="officers" aria-labelledby="officers-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">The people</p>
            <h2 id="officers-title">Club officers.</h2>
          </div>
          <p class="lede">
            Two cabinets run Chess United: the senior officers who steer the club, and a junior
            cabinet elected from the kids — the same offices, at their own table.
          </p>
        </div>

        {publishedOfficerGroups.map((group) => (
          <div class="officer-group" aria-labelledby={`officers-${group.id}`}>
            <div class="officer-group-head">
              <h3 id={`officers-${group.id}`}>{group.title}</h3>
              <p>{group.caption}</p>
            </div>

            <div class="team-grid">
              {group.officers.map((person) => (
                <article class={`team-card reveal${person.open ? ' team-card--open' : ''}`}>
                  {person.photo ? (
                    <img
                      class="team-photo"
                      src={person.photo}
                      width="320"
                      height="320"
                      alt={person.photoAlt ?? `Portrait of ${person.name}, ${person.role}`}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <p class="team-initials" aria-hidden="true">{person.open ? '+' : initials(person.name)}</p>
                  )}
                  <h3>{person.name}</h3>
                  <p>{person.role}</p>
                  {person.note && <p class="team-note">{person.note}</p>}
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="section section--paper" id="team" aria-labelledby="team-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Behind the board</p>
            <h2 id="team-title">The Chess United<br />team.</h2>
          </div>
          <p class="lede">
            The people who build, document and run the club — from the website and the
            membership system to the photos and the highlight reels.
          </p>
        </div>

        <div class="team-grid">
          {team.map((person) => (
            <article class="team-card reveal">
              {person.photo ? (
                <img
                  class="team-photo"
                  src={person.photo}
                  width="320"
                  height="320"
                  alt={person.photoAlt ?? `Portrait of ${person.name}, ${person.role}`}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <p class="team-initials" aria-hidden="true">{initials(person.name)}</p>
              )}
              <h3>{person.name}</h3>
              <p>{person.role}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--paper" id="partners" aria-labelledby="partners-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Backed by the community</p>
            <h2 id="partners-title">Tournament 1.0 partners<br />and sponsors.</h2>
          </div>
          <p class="lede">
            Tournament day took a village: local government, malls, businesses, media and
            community groups. These names are reproduced from the club's official partners
            poster.
          </p>
        </div>

        <dl class="partner-tiers">
          {partnerTiers.map((tier) => (
            <div class="partner-tier">
              <dt>{tier.tier}</dt>
              <dd>
                {tier.partners.map((partner) => <span class="partner-chip">{partner}</span>)}
              </dd>
            </div>
          ))}
        </dl>
        <p class="partner-note">
          Additional partner names appear on the printed poster. This list covers the tiers that
          are clearly legible on the supplied artwork.
        </p>

        <h3 class="sponsor-logos-title" id="sponsor-logos-title">The logos, in one place.</h3>
        <p class="partner-note">
          Every sponsor logo the club has supplied, scrolling past in two rows.
        </p>
        {sponsorRows.map((row, rowIndex) => (
          <div class={`sponsor-marquee${rowIndex === 1 ? ' sponsor-marquee--rev' : ''}`}>
            <div class={`sponsor-track sponsor-track--${rowIndex}`}>
              {/* second group is visual padding for the seamless loop */}
              {[0, 1].map((group) => (
                <div class="sponsor-group" aria-hidden={group === 1 ? 'true' : undefined}>
                  {row.map((sponsor) => (
                    <div class="sponsor-card">
                      <img
                        src={sponsor.src}
                        srcset={sponsor.srcset}
                        sizes="220px"
                        width="600"
                        height="450"
                        alt={`${sponsor.name} logo`}
                        loading="eager"
                        decoding="async"
                      />
                      <span class="sponsor-name">{sponsor.name}</span>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="cta-band" aria-labelledby="about-cta">
      <div class="wrap cta-inner">
        <div>
          <h2 id="about-cta" class="display-lg">Meet us at the board.</h2>
          <p>Saturdays from 10 AM — Robinsons Mall La Union.</p>
        </div>
        <div class="cta-actions">
          <a class="btn" href={site.groupUrl} target="_blank" rel="noopener">
            Join the group <Icon name="external" size={15} />
          </a>
          <a class="btn btn--light" href="/visit/">Find us</a>
        </div>
      </div>
    </section>
    <section class="section section--paper" id="privacy" aria-labelledby="privacy-title">
      <div class="wrap">
        <p class="eyebrow">Your information</p>
        <h2 id="privacy-title">Privacy and your choices.</h2>
        <div class="about-split mt-3">
          <div>
            <h3>What the club uses</h3>
            <p>Memberships, tournament entries and orders collect the contact details you enter, along with the information needed for your card, entry, payment check or delivery. Club officers use these records to handle your request and provide support.</p>
            <p class="mt-2">The website runs on Cloudflare. Copies of membership, entry and order details are kept in the club’s private Google spreadsheet for officer administration. Payments take place in GCash; this website never asks for your GCash PIN, OTP or password.</p>
          </div>
          <div>
            <h3>Your card and your records</h3>
            <p>Keep your private membership card link safe and share it only with people who need to see your card. A member number alone does not reveal your card. Parents and guardians should help younger players register and manage their links.</p>
            <p class="mt-2">Approved partner-club listings are public. To correct your details, request removal of a record or photo, replace a card link, or ask about how the club holds your information, <a href={site.groupUrl} target="_blank" rel="noopener noreferrer">contact the club officers</a>. Include your member or order number when relevant; never send a PIN or OTP.</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Base>
