---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
import { scriptUrl } from '../../lib/assets';
---
<Base title="Your order" description="Check your Chess United payment and delivery status using your private order link." noindex canonical={false}>
  <Header />
  <main id="main">
    <section class="section section--paper">
      <div class="wrap wrap--narrow">
        <p class="eyebrow">Your next move</p>
        <h1>Your order.</h1>
        <p class="lede">Payment confirmation and delivery updates from the club.</p>
        <p class="form-status mt-3" data-order-status-message role="status">Checking your private order link…</p>
        <article class="form-card mt-3" data-order-status hidden>
          <h2 data-status-order-no></h2>
          <p class="mt-2"><strong data-status-payment></strong></p>
          <p data-status-fulfilment></p>
          <p class="mt-2">Total: <strong data-status-total></strong></p>
          <p data-status-delivery></p>
          <p class="mt-2" data-status-tracking hidden>Tracking number: <strong data-tracking-number></strong> <a class="text-link" data-tracking-link target="_blank" rel="noopener noreferrer">Track with courier</a></p>
          <p class="note-box mt-3" data-status-guidance></p>
          <div class="form-actions mt-3">
            <button class="btn btn--sm" data-order-status-refresh type="button">Refresh status</button>
            <a class="btn btn--sm btn--ghost" href="/shop/#order" data-status-pay hidden>Continue payment</a>
          </div>
        </article>
        <p class="hint mt-3">Bookmark this private link. Anyone with the link can see this order’s status. For help, contact <a href={site.groupUrl} target="_blank" rel="noopener noreferrer">the club</a> with your order number.</p>
        <p class="mt-3"><a class="text-link" href="/shop/">Back to merchandise</a></p>
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline src={scriptUrl('order-status.js')} defer></script>
</Base>
