---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, events, mapsUrl } from '../data/site';

const origin = Astro.site ?? new URL('https://chessunited.pages.dev');
const abs = (path: string) => new URL(path, origin).href;

const tournament2 = events.find((event) => event.slug === 'tournament-2-0')!;
const mario = events.find((event) => event.slug === 'super-mario-cup')!;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Visit', item: abs('/visit/') },
  ],
};

const faqs = [
  {
    q: 'Where is the weekly session?',
    a: 'Robinsons Mall La Union, San Fernando City, La Union. The session runs every Saturday from 10:00 AM to 2:00 PM.',
  },
  {
    q: 'Where is Tournament 2.0?',
    a: 'Manna Mall, San Fernando City, La Union, on Saturday 7 November 2026 from 10:00 AM to 6:00 PM.',
  },
  {
    q: 'Where is the Super Mario Cup?',
    a: 'Ortega Convention Center, New Government Center, Barangay Sevilla / Sagayad, San Fernando City, La Union, on Saturday 5 December 2026 from 9:00 AM to 5:00 PM.',
  },
  {
    q: 'How do I register for a tournament?',
    a: 'Registration is handled by the club. Each event page lists the published division fees. Ask in the CHESS UNITED – REGION 1 NETWORK group for the current sign-up process.',
  },
  {
    q: 'Can parents and spectators come?',
    a: 'Tournament 1.0 photos show parents and spectators around the tables, and the weekly session happens in a public mall. For a specific event, ask in the group before you travel.',
  },
  {
    q: 'Does this website take payments?',
    a: 'No. This site is informational. It does not process registration, payments or personal data. Use the community group or speak to the club at a session.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base
  title="Visit — where Chess United plays"
  description="Find Chess United: weekly chess every Saturday at Robinsons Mall La Union, Tournament 2.0 at Manna Mall, and the Super Mario Cup at Ortega Convention Center."
  jsonLd={[breadcrumbJsonLd, faqJsonLd]}
>
  <Header />

  <main id="main">
    <header class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Visit</p>
        <h1>Find the table.</h1>
        <p class="lede">
          Weekly chess stays at Robinsons Mall La Union. Tournament days move to bigger venues.
          Here is every address, plus the group chat where the club posts updates.
        </p>
        <div class="page-hero-meta">
          <span><Icon name="pin" size={15} /> San Fernando City, La Union</span>
          <span><Icon name="calendar" size={15} /> Saturdays, 10 AM – 2 PM</span>
        </div>
      </div>
    </header>

    <section class="section" aria-labelledby="venues-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">The venues</p>
            <h2 id="venues-title">Where the boards are.</h2>
          </div>
          <p class="lede">
            The weekly session is the constant. Tournament venues change with the event — check
            the date before you travel.
          </p>
        </div>

        <div class="venue-grid">
          <article class="venue-card reveal">
            <span class="tag">Every Saturday</span>
            <h3>Robinsons Mall La Union</h3>
            <address>San Fernando City, La Union</address>
            <p class="venue-time">10:00 AM – 2:00 PM · weekly chess</p>
            <a class="text-link" href={mapsUrl(site.weekly.mapsQuery)} target="_blank" rel="noopener">
              Open in Google Maps <Icon name="external" size={13} />
            </a>
          </article>

          <article class="venue-card reveal">
            <span class="tag">Tournament 2.0 · 7 Nov</span>
            <h3>Manna Mall</h3>
            <address>San Fernando City, La Union</address>
            <p class="venue-time">10:00 AM – 6:00 PM · Open &amp; Kiddies</p>
            <a class="text-link" href={mapsUrl(tournament2.mapsQuery)} target="_blank" rel="noopener">
              Open in Google Maps <Icon name="external" size={13} />
            </a>
          </article>

          <article class="venue-card reveal">
            <span class="tag">Super Mario Cup · 5 Dec</span>
            <h3>Ortega Convention Center</h3>
            <address>
              New Government Center, Barangay Sevilla / Sagayad, San Fernando City, La Union
            </address>
            <p class="venue-time">9:00 AM – 5:00 PM · ₱50,000 winner take all</p>
            <a class="text-link" href={mapsUrl(mario.mapsQuery)} target="_blank" rel="noopener">
              Open in Google Maps <Icon name="external" size={13} />
            </a>
          </article>

          <article class="venue-card reveal">
            <span class="tag">Getting there</span>
            <h3>Plan your first visit</h3>
            <address>
              The weekly session is inside Robinsons Mall La Union. Ask for the chess tables if
              you can't spot them.
            </address>
            <p class="venue-time">Saturday chess: no sign-up on this site</p>
            <a class="text-link" href="/play/">
              What to expect <Icon name="arrow" size={13} />
            </a>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--paper" aria-labelledby="join-title">
      <div class="wrap detail-layout">
        <div>
          <p class="eyebrow">Stay in the loop</p>
          <h2 id="join-title" class="display-md">The group is the clubhouse.</h2>
          <div class="prose mt-2">
            <p>
              Chess United runs a Messenger group called
              <strong>CHESS UNITED – REGION 1 NETWORK</strong>. It is the club's community channel
              for schedules, questions and updates.
            </p>
            <p>
              Scan the QR code with your phone, or use the button below. If the weekly session is
              your first step, you can simply show up on a Saturday — the group is there for
              everything that needs a quick answer.
            </p>
          </div>

          <div class="hero-actions">
            <a class="btn" href={site.groupUrl} target="_blank" rel="noopener">
              Join the Messenger group <Icon name="external" size={15} />
            </a>
            <a class="btn btn--ghost" href="/events/">Tournament details</a>
          </div>

          <div class="note-box mt-3">
            <strong>Before a tournament:</strong> confirm the current sign-up process and your
            division in the group. Event pages on this site reproduce the published poster
            details; they do not take registrations or payments.
          </div>
        </div>

        <aside class="detail-aside">
          <div class="qr-card">
            <img
              src="/images/posters/community-qr-code.webp"
              width="480"
              height="480"
              alt="QR code to join the CHESS UNITED – REGION 1 NETWORK Messenger group."
              loading="lazy"
              decoding="async"
            />
            <div>
              <h3>Scan to join</h3>
              <p>CHESS UNITED – REGION 1 NETWORK on Messenger.</p>
              <a class="text-link" href={site.groupUrl} target="_blank" rel="noopener">
                Open link <Icon name="external" size={12} />
              </a>
            </div>
          </div>

          <div class="aside-card">
            <h3>Weekly checklist</h3>
            <ul class="checklist mt-2">
              <li><Icon name="check" size={16} /> Saturday, 10 AM – 2 PM</li>
              <li><Icon name="check" size={16} /> Robinsons Mall La Union</li>
              <li><Icon name="check" size={16} /> Kids, teens and adults</li>
              <li><Icon name="check" size={16} /> Bring a board or clock if you have one</li>
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <section class="section" aria-labelledby="visit-faq-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Practical questions</p>
            <h2 id="visit-faq-title">Before you go.</h2>
          </div>
          <p class="lede">
            The short answers. For anything specific to a date or a division, the group is the
            source of truth.
          </p>
        </div>

        <div class="faq">
          {faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <div class="faq-answer"><p>{item.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="visit-cta">
      <div class="wrap cta-inner">
        <div>
          <h2 id="visit-cta" class="display-lg">Saturday starts at 10.</h2>
          <p>Robinsons Mall La Union. The board is waiting.</p>
        </div>
        <div class="cta-actions">
          <a class="btn" href={mapsUrl(site.weekly.mapsQuery)} target="_blank" rel="noopener">
            Open in Maps <Icon name="external" size={15} />
          </a>
          <a class="btn btn--light" href={site.groupUrl} target="_blank" rel="noopener">
            Join the group
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
