---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, events, mapsUrl, weeklySessions } from '../data/site';
import { photos } from '../data/images';

const origin = Astro.site ?? new URL('https://chessunitedglobal.com');
const abs = (path: string) => new URL(path, origin).href;

const mario = events.find((event) => event.slug === 'super-mario-cup')!;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Visit', item: abs('/visit/') },
  ],
};

const faqs = [
  {
    q: 'Where is the weekly session?',
    a: 'Robinsons Mall La Union, every Saturday from 10:00 AM to 2:00 PM.',
  },
  {
    q: 'Do I need to sign up for Saturday chess?',
    a: 'No. The weekly session is not something you register for on this site. Come to Robinsons Mall La Union between 10:00 AM and 2:00 PM. If you want to check ahead, ask in the club\'s Messenger group.',
  },
  {
    q: 'Can beginners join?',
    a: 'Yes. The club\'s tagline is "chess for everyone." The weekly session is for kids, teens and adults, whether you are learning the moves or playing tournament chess.',
  },
  {
    q: 'What ages play?',
    a: 'Kids, teens and adults. Tournament days split into a Kiddies Division (12 and below) and an Open Division (13 and above).',
  },
  {
    q: 'What should I bring?',
    a: 'Just yourself. If you have a chess board or clock, bring it along; if not, come and watch a few games first.',
  },
  {
    q: 'Is there a fee for the weekly session?',
    a: 'The weekly poster does not list a session fee. Tournament entry fees are published on each event on the Events page.',
  },
  {
    q: 'Is Tournament 2.0 still open for registration?',
    a: 'No. Tournament 2.0 at Robinsons Mall La Union finished on 7 November 2026. Weekly chess continues every Saturday, 10 AM to 2 PM.',
  },
  {
    q: 'Where is the Super Mario Cup?',
    a: 'Ortega Convention Center, New Government Center, Barangay Sevilla / Sagayad, San Fernando City, La Union, on Saturday 5 December 2026 from 9:00 AM to 5:00 PM.',
  },
  {
    q: 'How do I enter a tournament?',
    a: 'Enter online from the Events page: pick your tournament and division, scan the club\'s GCash QR on that event\'s poster, pay the entry fee, then paste the 13-digit reference number. A club officer matches every reference by hand before your slot is confirmed.',
  },
  {
    q: 'Can parents and spectators come?',
    a: 'Tournament 1.0 photos show parents and spectators around the tables, and the weekly session happens in a public mall. For a specific event, ask in the group before you travel.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base
  title="Weekly chess every Saturday and how to visit — Chess United"
  description="Find Chess United: weekly Saturday chess at Robinsons Mall La Union, tournament venues, and how to join the club group."
  jsonLd={[breadcrumbJsonLd, faqJsonLd]}
>
  <Header />

  <main id="main">
    <header class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Visit &amp; weekly play</p>
        <h1>Find the table.</h1>
        <p class="lede">
          Weekly chess runs at Robinsons Mall La Union. Tournament days move to bigger venues.
          Here is every address, what a first Saturday looks like, plus the group chat where the
          club posts updates.
        </p>
        <div class="page-hero-meta">
          <span><Icon name="pin" size={15} /> San Fernando City, La Union</span>
          <span><Icon name="calendar" size={15} /> Saturdays, from 10 AM</span>
          <span><Icon name="users" size={15} /> Kids, teens and adults</span>
        </div>
      </div>
    </header>

    <section class="section" aria-labelledby="venues-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">The venues</p>
            <h2 id="venues-title">Where the boards are.</h2>
          </div>
          <p class="lede">
            The weekly session is the constant. Tournament venues change with the event — check
            the date before you travel.
          </p>
        </div>

        <div class="venue-grid">
          {weeklySessions.map((session) => (
            <article class="venue-card reveal">
              <span class="tag">{session.when}</span>
              <h3>{session.venue}</h3>
              <address>{session.address}</address>
              <p class="venue-time">{session.time} · weekly chess</p>
              <div class="venue-map-frame">
                <iframe
                  title={`Map preview for ${session.venue}`}
                  src={`https://maps.google.com/maps?q=${encodeURIComponent(session.address)}&output=embed`}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                ></iframe>
              </div>
              <p class="venue-map-note">
                Google Maps may show ratings and reviews for this venue. Those reviews are for the host location, not Chess United.
              </p>
              <a class="text-link" href={mapsUrl(session.mapsQuery)} target="_blank" rel="noopener noreferrer">
                View venue details and reviews <Icon name="external" size={13} />
              </a>
              <figure class="schedule-poster">
                <img
                  src={session.poster}
                  width={session.posterWidth}
                  height={session.posterHeight}
                  loading="lazy"
                  decoding="async"
                  alt={`Official Chess United weekly chess poster for the ${session.venue} session, ${session.when} from ${session.time}.`}
                />
                <figcaption>Club poster · {session.venue}</figcaption>
              </figure>
            </article>
          ))}

          <article class="venue-card reveal">
            <span class="tag">Super Mario Cup · 5 Dec</span>
            <h3>Ortega Convention Center</h3>
            <address>
              New Government Center, Barangay Sevilla / Sagayad, San Fernando City, La Union
            </address>
            <p class="venue-time">9:00 AM – 5:00 PM · ₱50,000 winner take all</p>
            <a class="text-link" href={mapsUrl(mario.mapsQuery)} target="_blank" rel="noopener">
              Open in Google Maps <Icon name="external" size={13} />
            </a>
          </article>

          <article class="venue-card reveal">
            <span class="tag">Getting there</span>
            <h3>Plan your first visit</h3>
            <address>
              The weekly table is in San Fernando City. Ask for the chess tables if you can't
              spot them.
            </address>
            <p class="venue-time">Saturday chess: no sign-up on this site</p>
            <a class="text-link" href="#first-saturday">
              What to expect <Icon name="arrow" size={13} />
            </a>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--paper" id="weekly" aria-labelledby="weekly-title">
      <div class="wrap about-split">
        <div class="about-photo reveal">
          <img
            src={photos.hall.src}
            srcset={photos.hall.srcset}
            sizes="(max-width: 980px) 92vw, 48vw"
            width={photos.hall.width}
            height={photos.hall.height}
            alt={photos.hall.alt}
            loading="lazy"
            decoding="async"
          />
          <span class="caption">Tournament 1.0 · Rovers Coffee</span>
        </div>

        <div>
          <p class="eyebrow">The weekly ritual</p>
          <h2 id="weekly-title" class="display-md">One table. All comers.</h2>
          <p class="lede">
            The Saturday session is the club's front door: a table in the mall, a clock, and
            whoever wants to play. Some come to prepare for the next tournament; others come to
            learn the moves. Everyone starts somewhere.
          </p>

          <ul class="checklist mt-2">
            <li><Icon name="check" size={17} /> Kids, teens and adults</li>
            <li><Icon name="check" size={17} /> Casual games and competitive games</li>
            <li><Icon name="check" size={17} /> A regular place to play, tournament or not</li>
            <li><Icon name="check" size={17} /> Same time, same place, every week</li>
          </ul>

          <div class="mt-2 badge-row">
            <span class="badge">Open session</span>
            <span class="badge">Robinsons Mall La Union</span>
            <span class="badge">Saturdays, 10 AM – 2 PM</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="first-saturday" aria-labelledby="first-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Your first Saturday</p>
            <h2 id="first-title">Three moves to start.</h2>
          </div>
          <p class="lede">Here's a simple way to start.</p>
        </div>

        <div class="value-grid">
          <article class="value-card reveal">
            <p class="value-num">01 / Show up</p>
            <h3>Come on Saturday.</h3>
            <p>
              The Saturday table runs at Robinsons Mall La Union from 10 AM to 2 PM. Come any week
              you like — it starts at 10.
            </p>
          </article>
          <article class="value-card reveal">
            <p class="value-num">02 / Say hello</p>
            <h3>Find the tables.</h3>
            <p>
              Look for the chess boards and introduce yourself. Ask for a game and see who's
              ready to play.
            </p>
          </article>
          <article class="value-card reveal">
            <p class="value-num">03 / Play</p>
            <h3>Sit down and start.</h3>
            <p>
              Shake hands, set the clock if there is one, and play. New to timed chess? Tell your
              opponent before the clock starts.
            </p>
          </article>
        </div>

        <div class="mt-3 badge-row">
          <a class="text-link" href={mapsUrl(weeklySessions[0].mapsQuery)} target="_blank" rel="noopener">
            Robinsons Mall La Union in Maps <Icon name="external" size={14} />
          </a>
        </div>
      </div>
    </section>

    <section class="section section--paper" aria-labelledby="join-title">
      <div class="wrap detail-layout">
        <div>
          <p class="eyebrow">Stay in the loop</p>
          <h2 id="join-title" class="display-md">The group is the clubhouse.</h2>
          <div class="prose mt-2">
            <p>
              Chess United runs a Messenger group called
              <strong>CHESS UNITED – REGION 1 NETWORK</strong>. It is the club's community channel
              for schedules, questions and updates.
            </p>
            <p>
              Scan the QR code with your phone, or use the button below. If the weekly session is
              your first step, you can simply show up on a Saturday — the group is there for
              everything that needs a quick answer.
            </p>
          </div>

          <div class="hero-actions">
            <a class="btn" href={site.groupUrl} target="_blank" rel="noopener">
              Join the Messenger group <Icon name="external" size={15} />
            </a>
            <a class="btn btn--ghost" href="/events/">Tournament details</a>
          </div>

          <div class="note-box mt-3">
            <strong>Before a tournament:</strong> enter online from the Events page and pay the
            entry fee by GCash. A club officer matches every reference number by hand before your
            slot is confirmed, so allow a little time for the check.
          </div>
        </div>

        <aside class="detail-aside">
          <div class="qr-card">
            <img
              src="/images/posters/community-qr-code.webp"
              width="480"
              height="480"
              alt="QR code to join the CHESS UNITED – REGION 1 NETWORK Messenger group."
              loading="lazy"
              decoding="async"
            />
            <div>
              <h3>Scan to join</h3>
              <p>CHESS UNITED – REGION 1 NETWORK on Messenger.</p>
              <a class="text-link" href={site.groupUrl} target="_blank" rel="noopener">
                Open link <Icon name="external" size={12} />
              </a>
            </div>
          </div>

          <div class="aside-card">
            <h3>Weekly checklist</h3>
            <ul class="checklist mt-2">
              <li><Icon name="check" size={16} /> Saturday, from 10 AM</li>
              <li><Icon name="check" size={16} /> Robinsons Mall La Union · 10 AM – 2 PM</li>
              <li><Icon name="check" size={16} /> Kids, teens and adults</li>
              <li><Icon name="check" size={16} /> Bring a board or clock if you have one</li>
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <section class="section" aria-labelledby="visit-faq-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Practical questions</p>
            <h2 id="visit-faq-title">Before you go.</h2>
          </div>
          <p class="lede">
            The short answers. For anything specific to a date or a division, the group is the
            source of truth.
          </p>
        </div>

        <div class="faq">
          {faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <div class="faq-answer"><p>{item.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="visit-cta">
      <div class="wrap cta-inner">
        <div>
          <h2 id="visit-cta" class="display-lg">Saturday starts at 10.</h2>
          <p>Robinsons Mall La Union, every Saturday from 10 AM. The board is waiting.</p>
        </div>
        <div class="cta-actions">
          <a class="btn" href={mapsUrl(weeklySessions[0].mapsQuery)} target="_blank" rel="noopener">
            Open in Maps <Icon name="external" size={15} />
          </a>
          <a class="btn btn--light" href={site.groupUrl} target="_blank" rel="noopener">
            Join the group
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
