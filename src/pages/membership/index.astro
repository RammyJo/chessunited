---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import {site} from '../../data/site';
import {scriptUrl} from '../../lib/assets';
const today=new Date(Date.now()+8*3600000).toISOString().slice(0,10);
const successTemplate='<h3>You’re registered.</h3><p>Thank you. Chess United has received your registration details.</p><p><a href="/visit/">See weekly play details</a> or <a href="/events/">browse upcoming events</a>.</p>';
---
<Base title="Club registration — Chess United" description="Register with Chess United: tell us your player details, chess experience and accompanying guests. Receive a simple acknowledgement when your details are saved.">
  <Header />
  <main id="main">
    <header class="page-hero"><div class="wrap"><p class="eyebrow">Chess United · Club registration</p><h1>Come and play.</h1><p class="lede">Tell us about the player and any guests coming along. Once your details are saved, we’ll acknowledge your registration here.</p></div></header>
    <section class="section" id="register" aria-labelledby="register-title"><div class="wrap registration-layout">
      <aside class="registration-intro"><p class="eyebrow">Join the community</p><h2 id="register-title">Register with the club.</h2><p>Kids, teens and adults are welcome. Parents or guardians should help younger players complete the form.</p><p>New to chess? Choose Beginner and Unrated. If you don’t belong to a chess club, leave that field blank.</p><p>This is general club registration. Tournament entry details are announced separately on the <a href="/events/">Events page</a>.</p><a class="text-link" href={site.groupUrl} target="_blank" rel="noopener noreferrer">Ask the club <Icon name="external" size={16} /></a></aside>
      <div data-form-shell>
        <form class="form-card" method="post" action="/api/club-registrations" data-api="/api/club-registrations" data-club-registration>
          <h3>Player registration</h3><p class="hint">Required fields are marked *. Your details are kept privately for club administration.</p>
          <div class="form-grid">
            <div class="field field--wide"><label for="r-name">Full name *</label><input id="r-name" name="fullName" required minlength="3" maxlength="120" autocomplete="name" /><p class="field-error" data-error-for="fullName" hidden></p></div>
            <div class="field"><label for="r-age">Age *</label><input id="r-age" name="age" type="number" min="0" max="120" readonly required data-number /><p class="hint">Calculated from your date of birth.</p><p class="field-error" data-error-for="age" hidden></p></div>
            <div class="field"><label for="r-birth">Date of birth *</label><input id="r-birth" name="dateOfBirth" type="date" min="1900-01-01" max={today} required autocomplete="bday" /><p class="field-error" data-error-for="dateOfBirth" hidden></p></div>
            <div class="field field--wide"><label for="r-brgy">Brgy name *</label><input id="r-brgy" name="barangay" required minlength="2" maxlength="120" autocomplete="address-level3" /><p class="field-error" data-error-for="barangay" hidden></p></div>
            <div class="field"><label for="r-city">City or municipality *</label><input id="r-city" name="city" required minlength="2" maxlength="100" autocomplete="address-level2" /><p class="field-error" data-error-for="city" hidden></p></div>
            <div class="field"><label for="r-province">Province *</label><input id="r-province" name="province" required minlength="2" maxlength="100" autocomplete="address-level1" /><p class="field-error" data-error-for="province" hidden></p></div>
            <div class="field"><label for="r-club">Chess club</label><input id="r-club" name="chessClub" maxlength="120" /><p class="hint">Leave blank if you are not part of a club.</p></div>
            <div class="field"><label for="r-level">Chess level *</label><select id="r-level" name="chessLevel" required><option value="">Choose your level</option><option>Beginner</option><option>Intermediate</option><option>Advanced</option></select><p class="field-error" data-error-for="chessLevel" hidden></p></div>
            <div class="field"><label for="r-source">Chess ranking source *</label><select id="r-source" name="rankingSource" required><option>Unrated</option><option>FIDE</option><option>Chess.com</option></select><p class="field-error" data-error-for="rankingSource" hidden></p></div>
            <div class="field" data-ranking-field hidden><label for="r-ranking">Chess ranking / rating *</label><input id="r-ranking" name="chessRanking" maxlength="80" disabled placeholder="e.g. 1200 rapid" /><p class="hint">Enter the rating or ranking shown by your selected source.</p><p class="field-error" data-error-for="chessRanking" hidden></p></div>
            <div class="field"><label for="r-tournaments">Tournaments played in *</label><select id="r-tournaments" name="tournamentsPlayed" required>{Array.from({length:100},(_,i)=><option value={String(i)}>{i}</option>)}<option value="100+">100+</option></select><p class="field-error" data-error-for="tournamentsPlayed" hidden></p></div>
            <div class="field"><label for="r-guests">Number of guests coming *</label><input id="r-guests" name="guestCount" type="number" min="0" max="100" value="0" required data-number /><p class="hint">Do not include the player. Enter 0 if coming alone.</p><p class="field-error" data-error-for="guestCount" hidden></p></div>
            <div class="field field--wide" data-guests-field hidden><label for="r-guest-names">Names of guests coming *</label><textarea id="r-guest-names" name="guestNames" maxlength="12000" rows="4" placeholder="One full name per line"></textarea><p class="hint">List one name for each guest counted above.</p><p class="field-error" data-error-for="guestNames" hidden></p></div>
          </div>
          <p class="hint mt-2"><a href="/about/#privacy">How the club uses your details</a></p><p class="form-status" data-form-status role="status" hidden></p>
          <div class="form-actions"><button class="btn" type="submit" data-busy="Registering…">Register <Icon name="check" size={16} /></button></div>
          <noscript><p class="note-box">Enable JavaScript to register online, or contact the club for help.</p></noscript>
        </form>
        <div class="form-success" data-success role="status" hidden><template data-success-template set:html={successTemplate}></template></div>
      </div>
    </div></section>
  </main><Footer />
  <script is:inline src={scriptUrl('registration-fields.js')} defer></script>
</Base>
<style>
 .registration-layout{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(2rem,5vw,4rem);align-items:start}.registration-intro{position:sticky;top:110px}.registration-intro h2{font-family:var(--font-display);font-size:clamp(1.8rem,3.5vw,3rem);line-height:1.15;margin-block:1rem}.registration-intro p{font-size:.95rem;line-height:1.8;margin-bottom:1rem}.registration-intro .text-link{font-size:.85rem}.field input[readonly]{background:var(--azure-tint)}@media(max-width:980px){.registration-layout{grid-template-columns:1fr}.registration-intro{position:static}}
</style>
