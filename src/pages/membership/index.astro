---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { site, membership, gcash, formatPeso } from '../../data/site';
import { photos } from '../../data/images';

const origin = Astro.site ?? new URL('https://chessunited.pages.dev');
const abs = (path: string) => new URL(path, origin).href;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Membership', item: abs('/membership/') },
  ],
};

/* The success panel is filled in the browser by public/scripts/forms.js, which
   swaps each {{placeholder}} for the value the server returns. It is kept as a
   string so the braces stay literal in the built HTML instead of being read as
   an Astro expression. */
const successTemplate = `
  <h3>Welcome to Chess United.</h3>
  <p>Your membership number is</p>
  <p class="success-code">{{member.memberNo}}</p>
  <p>
    Open your digital card any time at
    <a data-href="{{cardUrl}}">your membership card</a> — bookmark it, or show the number at a
    Saturday session.
  </p>
  <p>
    <strong>{{member.firstName}} {{member.lastName}}</strong> · {{member.division}} Division
  </p>
  <p>{{member.printedNote}}</p>
`;
---

<Base
  title="Membership — Chess United"
  description={`Register as a Chess United member online and get a digital club card. A printed membership ID with the club lanyard is ${formatPeso(membership.printFee)}, paid by GCash.`}
  jsonLd={breadcrumbJsonLd}
>
  <Header />

  <main id="main">
    <header class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Club membership</p>
        <h1>Join the club.</h1>
        <p class="lede">
          Register online and your digital membership card is issued straight away — a member
          number you can show at the table. Want the card in your hand? The printed ID with the
          club lanyard is {formatPeso(membership.printFee)}.
        </p>
        <div class="page-hero-meta">
          <span><Icon name="check" size={15} /> Free digital card</span>
          <span><Icon name="users" size={15} /> Open + Kiddies</span>
          <span><Icon name="spark" size={15} /> {formatPeso(membership.printFee)} printed</span>
        </div>
      </div>
    </header>

    <section class="section" id="register" aria-labelledby="register-title">
      <div class="wrap about-split">
        <div>
          <p class="eyebrow">Step one</p>
          <h2 id="register-title" class="display-md">Register online.</h2>
          <p class="lede">
            Four details are required: your name, email, mobile number and division. The member
            number is generated the moment you submit, and the club gets a copy in its dashboard.
          </p>

          <div class="pay-box mt-3">
            <strong>If you want the printed card</strong>
            <ol>
              <li>Tick the printed card option in the form.</li>
              <li>{gcash.instructions}</li>
              <li>Send {formatPeso(membership.printFee)} and paste the reference number in the form.</li>
              <li>The club checks the reference, prints the ID, and hands it over at a Saturday session.</li>
            </ol>
          </div>

          <figure class="about-photo mt-3 reveal" style="margin:0">
            <img
              src={photos.lanyard.src}
              srcset={photos.lanyard.srcset}
              sizes="(max-width: 980px) 92vw, 40vw"
              width={photos.lanyard.width}
              height={photos.lanyard.height}
              alt={photos.lanyard.alt}
              loading="lazy"
              decoding="async"
            />
            <figcaption class="caption">
              {membership.printIncludes} · {formatPeso(membership.printFee)}
            </figcaption>
          </figure>
        </div>

        <div data-form-shell>
          <form class="form-card" data-api="/api/members">
            <h3>Membership registration</h3>
            <p class="lede">
              Nothing is charged here. This form only issues the card and, if you ask for it, the
              printed ID order.
            </p>

            <div class="form-grid">
              <div class="field">
                <label for="m-first">First name</label>
                <input id="m-first" name="firstName" required minlength="2" maxlength="60" autocomplete="given-name" />
                <p class="field-error" data-error-for="firstName" hidden></p>
              </div>

              <div class="field">
                <label for="m-last">Last name</label>
                <input id="m-last" name="lastName" required minlength="2" maxlength="60" autocomplete="family-name" />
                <p class="field-error" data-error-for="lastName" hidden></p>
              </div>

              <div class="field">
                <label for="m-email">Email</label>
                <input id="m-email" name="email" type="email" required autocomplete="email" />
                <p class="field-error" data-error-for="email" hidden></p>
              </div>

              <div class="field">
                <label for="m-phone">Mobile number</label>
                <input id="m-phone" name="phone" required inputmode="tel" placeholder="09171234567" autocomplete="tel" />
                <p class="field-error" data-error-for="phone" hidden></p>
              </div>

              <div class="field">
                <label for="m-city">City or municipality</label>
                <input id="m-city" name="city" maxlength="80" autocomplete="address-level2" />
              </div>

              <div class="field">
                <label for="m-province">Province</label>
                <input id="m-province" name="province" maxlength="80" autocomplete="address-level1" />
              </div>

              <div class="field">
                <label for="m-birth">Year of birth</label>
                <input id="m-birth" name="birthYear" type="number" min="1900" max="2030" inputmode="numeric" data-number />
                <p class="hint">Used to place you in the right division.</p>
              </div>

              <div class="field">
                <label for="m-division">Division</label>
                <select id="m-division" name="division">
                  <option value="open">Open Division — 13 &amp; above</option>
                  <option value="kiddies">Kiddies Division — 12 &amp; below</option>
                </select>
              </div>

              <div class="field field--wide">
                <div class="check-row">
                  <input id="m-printed" name="printedId" type="checkbox" data-bool />
                  <label for="m-printed">
                    <strong>Print my membership ID — {formatPeso(membership.printFee)}</strong>
                    <span>{membership.printIncludes}, paid by GCash before printing.</span>
                  </label>
                </div>
              </div>

              <div class="field field--wide">
                <label for="m-ref">GCash reference number</label>
                <input id="m-ref" name="gcashRef" inputmode="numeric" maxlength="20" placeholder="13 digits" />
                <p class="hint">
                  Required only for the printed {formatPeso(membership.printFee)} card.
                </p>
                <p class="field-error" data-error-for="gcashRef" hidden></p>
              </div>
            </div>

            <p class="form-status" data-form-status hidden></p>

            <div class="form-actions">
              <button class="btn" type="submit" data-busy="Sending…">
                <Icon name="check" size={16} /> Register and get my card
              </button>
              <a class="btn btn--ghost" href="/membership/card/">Look up a card</a>
            </div>
          </form>

          <div class="form-success" data-success hidden>
            <template data-success-template set:html={successTemplate}></template>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--paper" aria-labelledby="how-card-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">The card</p>
            <h2 id="how-card-title">One number, two ways to carry it.</h2>
          </div>
          <p class="lede">
            The digital card costs nothing and never needs printing. The physical ID is the
            club's own print run.
          </p>
        </div>

        <div class="value-grid">
          <article class="value-card reveal">
            <p class="value-num">01 / Digital</p>
            <h3>Free, issued online.</h3>
            <p>
              Your member number is created the moment you register. Open the card page, or print
              it yourself onto paper or card stock — the page is laid out for it.
            </p>
          </article>
          <article class="value-card reveal">
            <p class="value-num">02 / Printed</p>
            <h3>{formatPeso(membership.printFee)} with the lanyard.</h3>
            <p>
              {membership.printIncludes} — the club's own ID card. Pay by GCash, paste the
              reference number, and collect it at a Saturday session.
            </p>
          </article>
          <article class="value-card reveal">
            <p class="value-num">03 / Verified</p>
            <h3>Every reference is checked.</h3>
            <p>
              A club officer matches each GCash reference number against the club account before
              the printed card is made. No reference, no print run.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="membership-cta">
      <div class="wrap cta-inner">
        <div>
          <h2 id="membership-cta" class="display-lg">Register, then come and play.</h2>
          <p>Membership is open to kids, teens and adults. Saturdays from 10 AM.</p>
        </div>
        <div class="cta-actions">
          <a class="btn" href={site.groupUrl} target="_blank" rel="noopener">
            Join the group <Icon name="external" size={15} />
          </a>
          <a class="btn btn--light" href="/play/">Weekly play</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
