---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { site, membership, formatPeso } from '../../data/site';

const origin = Astro.site ?? new URL('https://chessunited.pages.dev');
const abs = (path: string) => new URL(path, origin).href;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Membership', item: abs('/membership/') },
    { '@type': 'ListItem', position: 3, name: 'Membership card', item: abs('/membership/card/') },
  ],
};
---

<Base
  title="Your membership card — Chess United"
  description="Look up a Chess United membership card by member number, or print your own digital card. Printed IDs with the club lanyard are handed out after GCash is confirmed."
  noindex
  jsonLd={breadcrumbJsonLd}
>
  <Header />

  <main id="main">
    <header class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Digital membership card</p>
        <h1>Your club card.</h1>
        <p class="lede">
          Every Chess United member gets a number. Open this page on your phone to show at the
          table, or print it — the card is laid out to print cleanly on A4 or card stock.
        </p>
      </div>
    </header>

    <section class="section" aria-labelledby="card-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Member lookup</p>
            <h2 id="card-title">Find your card.</h2>
          </div>
          <p class="lede">
            The number came with your registration, formatted like CU-2026-0137. Add it to this
            page's address as <code>?m=</code> and it is remembered — the link your registration
            gives you already carries it.
          </p>
        </div>

        <div class="mt-3" data-member-card>
          <noscript>
            <p class="note-box">
              JavaScript is switched off, so the card cannot be looked up on this page. Ask in the
              club group and an officer will confirm your membership number.
            </p>
          </noscript>

          <div class="club-empty" data-card-loading hidden>Looking up your card…</div>

          <div class="club-empty" data-card-empty>
            <strong>No member number in this link.</strong> Append <code>?m=CU-2026-0137</code> to
            the address, or
            <a href="/membership/">register first</a> to get a number.
          </div>

          <div class="club-empty" data-card-error hidden>
            <strong data-card-error-message>That membership number was not found.</strong>
            Check the digits, or ask in the club group. If you have not registered yet,
            <a href="/membership/">the form takes a minute</a>.
          </div>

          <div data-card-body hidden>
            <article class="member-card">
              <div class="member-card-head">
                <img src="/images/logo.webp" width="560" height="560" alt="" />
                <div>
                  <span>Chess United</span>
                  <span>San Fernando · La Union</span>
                </div>
              </div>

              <div class="member-card-body">
                <dl>
                  <div>
                    <dt>Member</dt>
                    <dd data-card-name>—</dd>
                  </div>
                  <div>
                    <dt>Division</dt>
                    <dd data-card-division>—</dd>
                  </div>
                  <div>
                    <dt>Member since</dt>
                    <dd data-card-since>—</dd>
                  </div>
                  <div>
                    <dt>Status</dt>
                    <dd><span class="member-card-status" data-card-status>—</span></dd>
                  </div>
                </dl>

                <p class="member-card-number" data-card-number>—</p>
              </div>

              <div class="member-card-foot">
                <span>chessunitedglobal.com</span>
                <span data-card-print-note hidden>{formatPeso(membership.printFee)} printed ID</span>
              </div>
            </article>

            <div class="card-actions">
              <button class="btn" type="button" data-print-card>
                <Icon name="download" size={16} /> Print this card
              </button>
              <a class="btn btn--ghost" href={site.groupUrl} target="_blank" rel="noopener">
                Ask the club <Icon name="external" size={15} />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--paper" aria-labelledby="printed-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">If you want it in your hand</p>
            <h2 id="printed-title">The official printed ID.</h2>
          </div>
          <p class="lede">
            {formatPeso(membership.printFee)} — the printed membership card and the club lanyard
            together, paid by GCash before printing.
          </p>
        </div>

        <div class="value-grid">
          <article class="value-card">
            <p class="value-num">01 / Order</p>
            <h3>Tick the option when you register.</h3>
            <p>
              Or message the club if you are already a member — every member can add the printed
              card afterwards.
            </p>
          </article>
          <article class="value-card">
            <p class="value-num">02 / Pay</p>
            <h3>{formatPeso(membership.printFee)} by GCash.</h3>
            <p>
              Scan the club's GCash QR, then send the 13-digit reference number. The club matches
              it against the club account.
            </p>
          </article>
          <article class="value-card">
            <p class="value-num">03 / Collect</p>
            <h3>Pick it up on a Saturday.</h3>
            <p>
              Printed cards are handed over at the weekly sessions — Robinsons Mall La Union,
              or Rovers Coffee in the morning.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
