---
import Base from '../layouts/Base.astro';
import { sampleDailyOpens, sampleTotal } from '../data/analytics-sample';
const peak = sampleDailyOpens.reduce((best, day) => day.opens > best.opens ? day : best);
const average = (sampleTotal / sampleDailyOpens.length).toFixed(1);
---
<Base title="Sample analytics — Chess United" description="Illustrative Chess United analytics report: 478 sample site opens across 2–26 November 2026. Demonstration data, not measured traffic." noindex canonical={false}>
  <main id="main" class="analytics-report">
    <header class="report-header">
      <a class="brand" href="/" aria-label="Chess United homepage"><img src="/images/logo.webp" width="560" height="560" alt="" /><span>Chess United<small>San Fernando · La Union</small></span></a>
      <span class="report-tag">Unlisted report</span>
    </header>
    <div class="report-heading">
      <p class="eyebrow">Website overview</p>
      <h1>Site opens.</h1>
      <p class="period"><time datetime="2026-11-02">2 November</time> – <time datetime="2026-11-26">26 November 2026</time><span>Asia/Manila</span></p>
    </div>
    <aside class="sample-notice" aria-label="Sample data notice"><strong>Sample data</strong><p>This is an illustrative report with 478 sample opens. These numbers are not measured website traffic.</p></aside>
    <section class="metrics" aria-label="Sample traffic summary">
      <div class="metric metric-total"><p>Total sample opens</p><strong data-sample-total>{sampleTotal}</strong><span>Since 2 November 2026</span></div>
      <div class="metric"><p>Daily average</p><strong>{average}</strong><span>Sample opens per day · 25 days</span></div>
      <div class="metric"><p>Busiest sample day</p><strong>{peak.opens}</strong><span>{peak.day} November 2026</span></div>
    </section>
    <section class="chart-panel" aria-labelledby="daily-title">
      <div class="panel-heading"><div><p class="eyebrow">Day by day</p><h2 id="daily-title">Daily site opens</h2></div><span class="chart-legend"><i aria-hidden="true"></i> Sample opens</span></div>
      <p class="chart-help" id="chart-help">Select a bar to see that day in the breakdown below.</p>
      <div class="chart" role="group" aria-label="Daily sample opens, 2–26 November 2026" aria-describedby="chart-help">
        <div class="chart-scale" aria-hidden="true"><span>40</span><span>30</span><span>20</span><span>10</span><span>0</span></div>
        <div class="chart-bars">
          {sampleDailyOpens.map(day => <a class:list={['chart-bar',{'chart-bar-peak':day.date===peak.date}]} style={`--bar-height:${day.opens/40*100}%`} href={`#day-${day.date}`} aria-label={`${day.day} November: ${day.opens} sample opens, ${day.cumulative} cumulative`}><span class="bar-fill"></span><span class="bar-tooltip">Nov {day.day} · {day.opens} opens</span></a>)}
        </div>
      </div>
      <div class="chart-dates" aria-hidden="true"><span>2 Nov</span><span>8 Nov</span><span>14 Nov</span><span>20 Nov</span><span>26 Nov</span></div>
    </section>
    <section class="breakdown" aria-labelledby="breakdown-title">
      <div class="panel-heading"><div><p class="eyebrow">The numbers</p><h2 id="breakdown-title">Daily breakdown</h2></div><span class="small-label">Sample data · 25 days</span></div>
      <table>
        <caption class="sr-only">Daily sample opens and running total, 2–26 November 2026. Illustrative data only.</caption>
        <thead><tr><th scope="col">Date</th><th scope="col">Sample opens</th><th scope="col">Running total</th></tr></thead>
        <tbody>{sampleDailyOpens.map(day => <tr id={`day-${day.date}`} data-daily-row><th scope="row"><time datetime={day.date}>{day.day} Nov 2026</time></th><td data-daily-opens>{day.opens}</td><td data-running-total>{day.cumulative}</td></tr>)}</tbody>
        <tfoot><tr><th scope="row">Total</th><td>{sampleTotal}</td><td>{sampleTotal}</td></tr></tfoot>
      </table>
    </section>
    <footer class="report-footer">
      <h2>What counts as an open?</h2>
      <p>The metric shown is website opens, not unique people. Each time someone opens the website counts as one view, including repeat opens by the same person.</p>
      <p>This fixed sample demonstrates that metric. It does not collect visits or update with live traffic. Report as of 26 November 2026, Asia/Manila.</p>
      <p class="access-note">Shared by link · No login required. Anyone with this link can view the report.</p>
    </footer>
  </main>
</Base>
<style>
  .analytics-report{max-width:1120px;margin-inline:auto;padding:clamp(1.25rem,4vw,3rem);color:var(--ink)}
  .report-header{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-bottom:1.5rem;border-bottom:2px solid var(--ink)}
  .brand{display:flex;align-items:center;gap:.75rem;font-weight:800;font-size:.9rem;text-transform:uppercase;text-decoration:none}.brand img{width:48px;height:48px;background:#fff;border:2px solid var(--ink);padding:3px}.brand small{display:block;margin-top:.3rem;font-size:.55rem;letter-spacing:.08em;color:var(--muted)}
  .report-tag{font-size:.65rem;font-weight:800;border:1px solid var(--ink);padding:.5rem .7rem;text-align:center}
  .report-heading{padding-block:clamp(2rem,5vw,3.5rem)}h1{font-family:var(--font-display);font-size:clamp(2.8rem,8vw,5.2rem);line-height:1.1;letter-spacing:-.05em;margin:.8rem 0 1rem}
  .period{font-size:.9rem;line-height:1.8}.period span{display:inline-block;margin-left:1rem;color:var(--muted);font-size:.75rem}
  .sample-notice{padding:1rem 1.25rem;border:2px solid var(--ink);border-left:6px solid var(--gold);background:#fff7d7;margin-bottom:1.5rem}.sample-notice strong{font-size:.85rem}.sample-notice p{font-size:.8rem;line-height:1.7;margin-top:.25rem}
  .metrics{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:1rem;margin-bottom:2rem}.metric{min-width:0;border:2px solid var(--ink);background:#fff;padding:clamp(1rem,2.5vw,1.75rem);display:flex;flex-direction:column;gap:.7rem}.metric-total{background:var(--ink);color:#fff;box-shadow:5px 5px 0 var(--azure)}.metric p{font-size:.75rem;font-weight:800}.metric strong{font-family:var(--font-display);font-size:clamp(2.8rem,6vw,4.5rem);line-height:1.1;letter-spacing:-.05em;font-variant-numeric:tabular-nums}.metric span{font-size:.7rem;line-height:1.6;color:var(--muted)}.metric-total span{color:#c2dce9}
  .chart-panel,.breakdown{background:#fff;border:2px solid var(--ink);padding:clamp(1rem,3vw,2rem);margin-block:1.5rem}.panel-heading{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}h2{font-family:var(--font-display);font-size:clamp(1.15rem,3vw,1.6rem);line-height:1.3;margin-top:.5rem}.eyebrow{font-size:.6rem}.chart-legend,.small-label{font-size:.7rem;color:var(--muted)}.chart-legend{display:flex;align-items:center;gap:.5rem}.chart-legend i{width:10px;height:10px;background:var(--azure)}.chart-help{font-size:.75rem;line-height:1.7;color:var(--muted);margin-top:1rem}
  .chart{height:240px;display:grid;grid-template-columns:28px minmax(0,1fr);gap:.5rem;margin-top:2.5rem}.chart-scale{display:flex;flex-direction:column;justify-content:space-between;font-size:.65rem;color:var(--muted);text-align:right;transform:translateY(-5px)}.chart-bars{display:grid;grid-template-columns:repeat(25,minmax(0,1fr));gap:clamp(2px,.55vw,6px);height:100%;background:repeating-linear-gradient(to top,rgba(10,21,51,.12) 0 1px,transparent 1px 25%);border-bottom:1px solid var(--ink)}.chart-bar{height:100%;display:flex;align-items:end;position:relative;min-width:0;scroll-margin-top:1rem}.bar-fill{display:block;width:100%;height:var(--bar-height);background:var(--azure);border-top:2px solid var(--ink)}.chart-bar-peak .bar-fill{background:var(--ink)}.chart-bar:hover .bar-fill,.chart-bar:focus-visible .bar-fill{background:var(--red-ink)}.chart-bar:focus-visible{outline:2px solid var(--ink);outline-offset:2px}.bar-tooltip{display:none;position:absolute;z-index:2;bottom:calc(var(--bar-height) + 8px);left:50%;transform:translateX(-50%);font-size:.65rem;white-space:nowrap;background:var(--ink);color:#fff;padding:.5rem;pointer-events:none}.chart-bar:hover .bar-tooltip,.chart-bar:focus-visible .bar-tooltip{display:block}.chart-bar:first-child .bar-tooltip{left:0;transform:none}.chart-bar:last-child .bar-tooltip{left:auto;right:0;transform:none}.chart-dates{display:flex;justify-content:space-between;padding-left:36px;margin-top:.7rem;font-size:.65rem;color:var(--muted)}
  table{width:100%;border-collapse:collapse;margin-top:1.5rem;font-variant-numeric:tabular-nums}th,td{padding:.85rem .6rem;border-bottom:1px solid rgba(10,21,51,.15);text-align:right;font-size:.8rem}th:first-child{text-align:left}thead th{font-size:.65rem;line-height:1.6;color:var(--muted)}tbody th{font-weight:600}tbody tr{scroll-margin-top:1rem}tbody tr:target{background:var(--azure-tint);outline:2px solid var(--azure-ink);outline-offset:-2px}tfoot{background:var(--ink);color:#fff}tfoot th,tfoot td{font-weight:800;border:0}
  .report-footer{padding-block:1rem 2rem;max-width:700px}.report-footer h2{font-size:1rem}.report-footer p{font-size:.8rem;line-height:1.8;color:var(--muted);margin-top:.75rem}.report-footer .access-note{font-size:.7rem;border-top:1px solid rgba(10,21,51,.2);padding-top:1rem;margin-top:1.5rem}
  @media(max-width:650px){.metrics{grid-template-columns:1fr 1fr}.metric-total{grid-column:1/-1}.metric strong{font-size:2.8rem}.report-tag{max-width:75px}.brand{font-size:.75rem}.brand small{font-size:.48rem}.period span{display:block;margin-left:0}.chart{height:180px}.chart-panel,.breakdown{padding:1rem .75rem}th,td{padding:.8rem .35rem;font-size:.7rem}thead th{font-size:.6rem}.chart-help{max-width:30ch}}
  @media print{.analytics-report{max-width:none;padding:0}.chart-panel,.metrics,.sample-notice{break-inside:avoid}.report-tag{display:none}tbody tr{break-inside:avoid}.bar-fill{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style>
