---
import Base from '../layouts/Base.astro';
import {scriptUrl} from '../lib/assets';
import AnalyticsDetails from '../components/AnalyticsDetails.astro';
---
<Base title="Website analytics — Chess United" description="Chess United website opens, traffic sources, active time, popular pages, exits and new versus returning visits." noindex canonical={false}>
  <main id="main" class="analytics-report" data-analytics-report>
    <header class="report-header"><a class="brand" href="/" aria-label="Chess United homepage"><img src="/images/logo.webp" width="560" height="560" alt="" /><span>Chess United<small>San Fernando · La Union</small></span></a><span class="report-tag">Unlisted report</span></header>
    <div class="report-heading"><p class="eyebrow">Website overview</p><h1>Website analytics.</h1><p class="period">Dates in Asia/Manila · Repeat opens count again.</p></div>
    <div class="report-status"><p role="status" aria-live="polite" data-report-status>Loading analytics…</p><button type="button" class="refresh-button" data-refresh>Refresh data</button></div>
    <form data-report-filters>
      <fieldset disabled><legend class="sr-only">Report dates and grouping</legend><div class="filter-grid">
        <label>View<select name="period"><option value="day">Daily</option><option value="week">Weekly</option><option value="month">Monthly</option><option value="year">Yearly</option></select></label>
        <label>From<input name="from" type="date" required /></label><label>To<input name="to" type="date" required /></label><button class="btn" type="submit">Apply dates</button>
      </div><div class="presets" aria-label="Date ranges"><button type="button" data-preset="today">Today</button><button type="button" data-preset="7">Last 7 days</button><button type="button" data-preset="30">Last 30 days</button><button type="button" data-preset="month">This month</button><button type="button" data-preset="year">This year</button><button type="button" data-preset="all" aria-pressed="true">All history</button></div></fieldset>
    </form>
    <p class="range-label" data-range-label></p>
    <section class="metrics" aria-label="Traffic summary">
      <div class="metric metric-total"><p>Total opens</p><strong data-total>—</strong><span data-total-note>Waiting for recorded data</span></div>
      <div class="metric"><p>Daily average</p><strong data-average>—</strong><span>Opens per day in this date range</span></div>
      <div class="metric"><p data-peak-label>Busiest day</p><strong data-peak>—</strong><span data-peak-note>Waiting for recorded data</span></div>
    </section>
    <AnalyticsDetails />
    <aside class="visit-insight" data-november-insight hidden><p class="eyebrow">Traffic increase</p><h2>25 November 2026</h2><p data-november-copy></p></aside>
    <section class="chart-panel" aria-labelledby="daily-title"><div class="panel-heading"><div><p class="eyebrow">Traffic over time</p><h2 id="daily-title" data-chart-title>Daily opens</h2></div><span class="chart-legend"><i aria-hidden="true"></i> Website opens</span></div><p class="chart-help" data-chart-help>Select a bar to see its breakdown below.</p><div class="chart" role="group" aria-label="Website opens by date"><div class="chart-scale" aria-hidden="true" data-chart-scale></div><div class="chart-bars" data-chart-bars></div></div><div class="chart-dates" aria-hidden="true" data-chart-dates></div></section>
    <section class="breakdown" aria-labelledby="breakdown-title"><div class="panel-heading"><div><p class="eyebrow">The numbers</p><h2 id="breakdown-title" data-breakdown-title>Daily breakdown</h2></div><span class="small-label" data-period-count></span></div>
      <table><caption class="sr-only">Website opens by date. Historical Cloudflare counts are estimates; new public page opens are recorded directly.</caption><thead><tr><th scope="col">Period</th><th scope="col">Opens</th><th scope="col">Change</th><th scope="col">Source</th></tr></thead><tbody data-report-rows></tbody><tfoot><tr><th scope="row">Total</th><td data-table-total>—</td><td colspan="2"></td></tr></tfoot></table>
      <div class="pagination"><button type="button" data-page-prev disabled>Previous</button><p data-page-label></p><button type="button" data-page-next disabled>Next</button></div>
    </section>
    <footer class="report-footer"><h2>How to read this report</h2><p data-coverage>Historical counts come from Cloudflare Web Analytics. New page opens are counted automatically.</p><p>Historical counts are estimates, marked with ≈. New recorded opens count each public page load or browser Back/Forward return, including repeated opens by the same person. Report pages, private pages and automated checks are excluded.</p><p>Weeks begin on Monday. Date filters may show part of a week, month or year. Change compares consecutive complete periods; incomplete periods show a dash. Browser-based counting can miss opens when scripts or requests are blocked.</p><p>Counts refresh automatically while this report is open. New and returning visits use a random browser identifier stored locally for up to 90 days. No names, form answers or private URLs appear in analytics. Browsers and visits are not guaranteed to represent individual people. <a href="/about/#privacy">Privacy details</a>.</p><p class="access-note">Shared by link · No login required. Anyone with this link can view the report.</p></footer>
    <noscript><p class="data-note">Enable JavaScript to load the live report and change its date ranges.</p></noscript>
  </main>
  <script is:inline type="module" src={scriptUrl('analytics-report.js')}></script>
</Base>
<style is:global>
.analytics-report{max-width:1120px;margin-inline:auto;padding:clamp(1.25rem,4vw,3rem);color:var(--ink)}.analytics-report .report-header{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-bottom:1.5rem;border-bottom:2px solid var(--ink)}.analytics-report .brand{display:flex;align-items:center;gap:.75rem;font-weight:800;font-size:.9rem;text-transform:uppercase;text-decoration:none}.analytics-report .brand img{width:48px;height:48px;background:#fff;border:2px solid var(--ink);padding:3px}.analytics-report .brand small{display:block;margin-top:.3rem;font-size:.55rem;letter-spacing:.08em;color:var(--muted)}.analytics-report .report-tag{font-size:.65rem;font-weight:800;border:1px solid var(--ink);padding:.5rem .7rem;text-align:center}.analytics-report .report-heading{padding-block:clamp(2rem,5vw,3.5rem) 1.5rem}.analytics-report h1{font-family:var(--font-display);font-size:clamp(2.8rem,8vw,5.2rem);line-height:1.1;letter-spacing:-.05em;margin:.8rem 0 1rem}.analytics-report .period{font-size:.85rem;line-height:1.8;color:var(--muted)}
.analytics-report button,.analytics-report input,.analytics-report select{font:inherit}.analytics-report button{cursor:pointer}.analytics-report button:disabled{cursor:default;opacity:.5}.analytics-report .report-status{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.25rem;font-size:.75rem;line-height:1.7}.analytics-report .report-status [data-error]{color:var(--red-ink)}.analytics-report .refresh-button,.analytics-report .pagination button{background:#fff;color:var(--ink);border:1px solid var(--ink);padding:.65rem .85rem;min-height:44px;font-size:.75rem;font-weight:800}.analytics-report fieldset{border:2px solid var(--ink);padding:clamp(1rem,2vw,1.5rem);margin:0;background:#fff;min-width:0}.analytics-report .filter-grid{display:grid;grid-template-columns:1fr 1fr 1fr auto;align-items:end;gap:.85rem}.analytics-report label{display:flex;flex-direction:column;gap:.5rem;font-size:.7rem;font-weight:800;min-width:0}.analytics-report select,.analytics-report input{width:100%;min-width:0;max-width:100%;min-height:44px;padding:.6rem;border:1px solid var(--ink);border-radius:0;color:var(--ink);background:#fff;font-size:.8rem;box-sizing:border-box}.analytics-report .filter-grid .btn{font-size:.7rem;font-weight:800;min-height:44px;padding:.7rem;white-space:nowrap}.analytics-report .presets{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}.analytics-report .presets button{min-height:38px;padding:.4rem .65rem;font-size:.65rem;font-weight:800;border:1px solid var(--ink);background:#fff;color:var(--ink)}.analytics-report .presets button[aria-pressed=true]{background:var(--ink);color:#fff}.analytics-report .range-label{margin-block:1.25rem;font-size:.8rem;line-height:1.7;font-weight:700}
.analytics-report .metrics{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:1rem;margin-bottom:2rem}.analytics-report .metric{min-width:0;border:2px solid var(--ink);background:#fff;padding:clamp(1rem,2.5vw,1.75rem);display:flex;flex-direction:column;gap:.7rem}.analytics-report .metric-total{background:var(--ink);color:#fff;box-shadow:5px 5px 0 var(--azure)}.analytics-report .metric p{font-size:.75rem;font-weight:800}.analytics-report .metric strong{font-family:var(--font-display);font-size:clamp(2.2rem,5vw,4.1rem);line-height:1.1;letter-spacing:-.05em;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.analytics-report .metric span{font-size:.7rem;line-height:1.6;color:var(--muted)}.analytics-report .metric-total span{color:#c2dce9}.analytics-report .visit-insight{padding:1.25rem;border:2px solid var(--ink);border-left:6px solid var(--gold);background:#fff7d7;margin-block:1.5rem}.analytics-report .visit-insight p:last-child{font-size:.85rem;line-height:1.8;margin-top:.5rem}
.analytics-report .chart-panel,.analytics-report .breakdown{background:#fff;border:2px solid var(--ink);padding:clamp(1rem,3vw,2rem);margin-block:1.5rem}.analytics-report .panel-heading{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}.analytics-report h2{font-family:var(--font-display);font-size:clamp(1.15rem,3vw,1.6rem);line-height:1.3;margin-top:.5rem}.analytics-report .eyebrow{font-size:.6rem}.analytics-report .chart-legend,.analytics-report .small-label{font-size:.7rem;color:var(--muted)}.analytics-report .chart-legend{display:flex;align-items:center;gap:.5rem}.analytics-report .chart-legend i{width:10px;height:10px;background:var(--azure)}.analytics-report .chart-help{font-size:.75rem;line-height:1.7;color:var(--muted);margin-top:1rem}.analytics-report .chart{height:240px;display:grid;grid-template-columns:45px minmax(0,1fr);gap:.5rem;margin-top:2.5rem}.analytics-report .chart-scale{display:flex;flex-direction:column;justify-content:space-between;font-size:.6rem;color:var(--muted);text-align:right;transform:translateY(-5px)}.analytics-report .chart-bars{display:flex;justify-content:space-around;gap:clamp(2px,.55vw,6px);height:100%;background:repeating-linear-gradient(to top,rgba(10,21,51,.12) 0 1px,transparent 1px 25%);border-bottom:1px solid var(--ink)}.analytics-report .chart-bar{flex:1;max-width:60px;height:100%;display:flex;align-items:end;position:relative;min-width:0}.analytics-report .bar-fill{display:block;width:100%;height:var(--bar-height);min-height:1px;background:var(--azure);border-top:2px solid var(--ink)}.analytics-report .chart-bar-zero .bar-fill{min-height:0;border-top:0}.analytics-report .chart-bar-increase .bar-fill{background:var(--gold)}.analytics-report .chart-bar:hover .bar-fill,.analytics-report .chart-bar:focus-visible .bar-fill{background:var(--red-ink)}.analytics-report .bar-tooltip{display:none;position:absolute;z-index:2;bottom:calc(var(--bar-height) + 8px);left:50%;transform:translateX(-50%);font-size:.65rem;white-space:nowrap;background:var(--ink);color:#fff;padding:.5rem;pointer-events:none}.analytics-report .chart-bar:hover .bar-tooltip,.analytics-report .chart-bar:focus-visible .bar-tooltip{display:block}.analytics-report .chart-bar:first-child .bar-tooltip{left:0;transform:none}.analytics-report .chart-bar:last-child .bar-tooltip{left:auto;right:0;transform:none}.analytics-report .chart-dates{display:flex;justify-content:space-between;padding-left:53px;gap:1rem;margin-top:.7rem;font-size:.6rem;color:var(--muted)}
.analytics-report table{width:100%;border-collapse:collapse;margin-top:1.5rem;font-variant-numeric:tabular-nums}.analytics-report th,.analytics-report td{padding:.85rem .6rem;border-bottom:1px solid rgba(10,21,51,.15);text-align:right;font-size:.75rem;line-height:1.6}.analytics-report th:first-child{text-align:left}.analytics-report thead th{font-size:.65rem;color:var(--muted)}.analytics-report tbody th{font-weight:600}.analytics-report tr{scroll-margin-top:1rem}.analytics-report tr:focus{background:var(--azure-tint);outline:2px solid var(--azure-ink);outline-offset:-2px}.analytics-report tfoot{background:var(--ink);color:#fff}.analytics-report tfoot th,.analytics-report tfoot td{font-weight:800;border:0}.analytics-report .source-label{font-size:.6rem;color:var(--muted)}.analytics-report .pagination{display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-top:1rem}.analytics-report .pagination p{font-size:.65rem;line-height:1.6;text-align:center}.analytics-report .report-footer{padding-block:1rem 2rem;max-width:760px}.analytics-report .report-footer h2{font-size:1rem}.analytics-report .report-footer p{font-size:.75rem;line-height:1.8;color:var(--muted);margin-top:.75rem}.analytics-report .report-footer .access-note{font-size:.7rem;border-top:1px solid rgba(10,21,51,.2);padding-top:1rem;margin-top:1.5rem}.analytics-report button:focus-visible,.analytics-report a:focus-visible,.analytics-report input:focus-visible,.analytics-report select:focus-visible{outline:3px solid var(--azure-ink);outline-offset:3px}
@media(max-width:650px){.analytics-report .filter-grid{grid-template-columns:1fr 1fr}.analytics-report .metrics{grid-template-columns:1fr 1fr}.analytics-report .metric-total{grid-column:1/-1}.analytics-report .metric strong{font-size:2.5rem}.analytics-report .report-tag{max-width:75px}.analytics-report .brand{font-size:.75rem}.analytics-report .brand small{font-size:.48rem}.analytics-report .chart{height:180px;grid-template-columns:32px minmax(0,1fr)}.analytics-report .chart-panel,.analytics-report .breakdown{padding:1rem .75rem}.analytics-report th,.analytics-report td{padding:.75rem .2rem;font-size:.65rem}.analytics-report thead th{font-size:.57rem}.analytics-report .source-label{font-size:.53rem}.analytics-report .chart-help{max-width:35ch}.analytics-report .chart-dates{padding-left:40px}}
@media print{.analytics-report{max-width:none;padding:0}.analytics-report .chart-panel,.analytics-report .metrics,.analytics-report .visit-insight{break-inside:avoid}.analytics-report .report-status,.analytics-report .presets,.analytics-report .pagination{display:none}.analytics-report tr{break-inside:avoid}.analytics-report .bar-fill{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style>
