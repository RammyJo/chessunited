---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import { site } from '../data/site';
import { galleryAll } from '../data/images';

const origin = Astro.site ?? new URL('https://chessunited.pages.dev');
const abs = (path: string) => new URL(path, origin).href;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Gallery', item: abs('/gallery/') },
  ],
};
---

<Base
  title="Gallery — Chess United"
  description="Photographs from Chess United Tournament 1.0 at Rovers Coffee and club gatherings in San Fernando City, La Union."
  jsonLd={breadcrumbJsonLd}
>
  <Header />

  <main id="main">
    <header class="page-hero">
      <div class="wrap">
        <p class="eyebrow">From the club</p>
        <h1>The week in pictures.</h1>
        <p class="lede">
          Tournament 1.0 at Rovers Coffee, the medals, and the crew around the club.
        </p>
        <div class="page-hero-meta">
          <span><Icon name="calendar" size={15} /> 17 October 2026</span>
          <span><Icon name="pin" size={15} /> Rovers Coffee, Carlatan</span>
          <span><Icon name="trophy" size={15} /> Tournament 1.0 + club life</span>
        </div>
      </div>
    </header>

    <section class="section" aria-label="Photo gallery">
      <div class="wrap">
        <Gallery photos={galleryAll} variant="full" />
        <p class="muted mt-2" style="font-size:.78rem">
          Photos supplied by Chess United. Select any image to view it larger; use the arrow
          keys or the on-screen buttons to move through the set.
        </p>
      </div>
    </section>

    <section class="section section--paper" aria-labelledby="gallery-cta-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Be in the next set</p>
            <h2 id="gallery-cta-title">The next tournament is 7 November.</h2>
          </div>
          <p class="lede">
            Tournament 2.0 moves to Manna Mall. Kids play the Kiddies Division; everyone 13 and
            above plays the Open.
          </p>
        </div>
        <div class="hero-actions">
          <a class="btn" href="/events/#tournament-2-0">Tournament 2.0 details <Icon name="arrow" size={16} class="arrow" /></a>
          <a class="btn btn--ghost" href="/play/">Weekly play</a>
        </div>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="gallery-cta">
      <div class="wrap cta-inner">
        <div>
          <h2 id="gallery-cta" class="display-lg">Bring your game.</h2>
          <p>Every Saturday at Robinsons Mall La Union.</p>
        </div>
        <div class="cta-actions">
          <a class="btn" href={site.groupUrl} target="_blank" rel="noopener">
            Join the group <Icon name="external" size={15} />
          </a>
          <a class="btn btn--light" href="/visit/">Find us</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
