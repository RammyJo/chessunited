---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import TournamentResults from '../../components/TournamentResults.astro';
import SMVenue from '../../components/SMVenue.astro';
import { eventArchive, eventPath, type ArchivedEvent } from '../../data/event-archive';
import { eventPhase } from '../../lib/event-dates.mjs';
import { site, formatPeso, mapsUrl } from '../../data/site';
import { scriptUrl } from '../../lib/assets';
export function getStaticPaths() { return eventArchive.map(event => ({params:{slug:event.slug},props:{event}})); }
interface Props { event: ArchivedEvent }
const { event }: Props = Astro.props;
const past = eventPhase(event) === 'past';
const origin = Astro.site ?? new URL('https://chessunitedglobal.com');
const abs = (path: string) => new URL(path, origin).href;
const schema = {
  '@context':'https://schema.org','@type':event.kind==='Coaching'?'EducationEvent':'SportsEvent',
  name:event.name, description:event.description, url:abs(eventPath(event)), startDate:event.date,
  endDate:event.endDate, eventStatus:'https://schema.org/EventScheduled',
  eventAttendanceMode:'https://schema.org/OfflineEventAttendanceMode',
  image:abs(event.poster?.src ?? '/images/og.jpg'),
  organizer:event.organizer?{'@type':'Organization',name:event.organizer}:undefined,
  location:{'@type':event.venuePending?'AdministrativeArea':'Place',name:event.venuePending?event.region:event.venue,
    address:{'@type':'PostalAddress',addressLocality:event.locality,addressRegion:event.region,addressCountry:'PH'}},
};
---
<Base title={event.name} description={`${event.name} · ${event.dateLabel} · ${event.venue}. Event details and original artwork.`.slice(0,160)} image={event.poster ? abs(event.poster.src) : undefined} imageWidth={event.poster?.width} imageHeight={event.poster?.height} imageAlt={event.poster?.alt} jsonLd={schema}>
  <Header />
  <main id="main" data-event-detail data-event-end={event.endDate}>
    <header class="page-hero"><div class="wrap">
      <p class="eyebrow">{event.scope} · {event.kind}</p><h1>{event.name}</h1>
      <p class="lede">{event.dateLabel} · {event.venue}</p>
      <div class="page-hero-meta"><span class:list={['status-pill',{'status-pill--past':past}]} data-event-status>{past?'Past event':'Present event'}</span><a class="text-link" href={`/events/#${past?'past':'present'}-events`}>All events <Icon name="arrow" size={15} /></a></div>
    </div></header>
    <section class="section"><div class="wrap event-detail">
      <div>
        <h2>Event details</h2>
        <dl class="fact-grid">
          <div class="fact"><dt>Dates</dt><dd>{event.dateLabel}</dd></div>
          <div class="fact"><dt>Venue</dt><dd>{event.venue}<span>{event.locality}{event.locality!==event.region?`, ${event.region}`:''}</span></dd></div>
          <div class="fact"><dt>{event.organizer?'Organiser':'Time control'}</dt><dd>{event.organizer ?? event.format ?? 'See the original poster'}</dd></div>
        </dl>
        <p class="lede mt-3">{event.description}</p>
        {event.format && <p class="event-note">{event.format}</p>}
        {event.categories && <p class="event-note">{event.categories}</p>}
        {event.prizes && <p class="event-note">{event.prizes}</p>}
        <p class="event-note" data-past-only hidden={!past}>This event is archived. Registration and payment are closed.</p>
        {event.clubEvent?.detailsPending && <p class="note-box" id="register" data-present-only hidden={past}>Registration details coming soon. The official announcement will confirm the time, divisions and entry fees.</p>}
        <div class="event-actions" data-present-only hidden={past}>
          {event.registrationUrl && <a class="btn" href={event.registrationUrl} target="_blank" rel="noopener noreferrer">Organiser’s registration form <Icon name="external" size={15} /></a>}
          {event.contacts?.map(contact => <a class="btn btn--ghost" href={`tel:+63${contact.phone.slice(1)}`}>{contact.name} · {contact.phone}</a>)}
          {event.organizer==='Chess United' && <a class="btn" href={site.groupUrl} target="_blank" rel="noopener noreferrer">Club updates <Icon name="external" size={15} /></a>}
          {!event.venuePending && <a class="btn btn--ghost" href={mapsUrl(`${event.venue}, ${event.locality}, ${event.region}`)} target="_blank" rel="noopener noreferrer">Open in Maps <Icon name="pin" size={15} /></a>}
          {event.ics && <a class="text-link" href={event.ics}>Add to calendar <Icon name="calendar" size={15} /></a>}
        </div>
        <p class="event-note">This event page remains in the archive after its date.</p>
        {event.clubEvent && event.clubEvent.divisions.length>0 && <details class="original-details"><summary>Published divisions &amp; prizes</summary>
          {event.clubEvent.divisions.map(division => <div class="prize-block"><h3>{division.name}<span>{division.ages}</span></h3><p>Published entry fee: {formatPeso(division.fee)}</p><div class="prize-table">{division.prizes.map(prize => <p class="prize-row"><span>{prize.place}</span><span class="dots"></span><strong>{formatPeso(prize.amount)}</strong>{prize.note && <span class="note">{prize.note}</span>}</p>)}</div></div>)}
        </details>}
        {event.profilePoster && <details class="original-details"><summary>Coach Henry’s online classes</summary><p class="event-note">This is his online class schedule. The La Union visit’s session details will be announced by Chess United.</p><a href={event.profilePoster.src} target="_blank" rel="noopener noreferrer"><img {...event.profilePoster} sizes="(max-width:650px) 85vw, 436px" loading="lazy" decoding="async" /></a></details>}
      </div>
      {event.poster ? <figure class="poster-card"><a href={event.poster.src} target="_blank" rel="noopener noreferrer" aria-label={`View the full poster for ${event.name}`}><img {...event.poster} sizes="(max-width:980px) 90vw, 480px" loading="lazy" decoding="async" /></a><figcaption>Original event poster · {event.dateLabel}</figcaption></figure> : event.slug==='tournament-3-0' ? <SMVenue tournament /> : <aside class="announcement"><p class="eyebrow">Chess United</p><h2>{event.shortName}</h2><p>{event.dateLabel}</p><p>{event.venuePending?'Session venue and time to be announced.':'Official tournament poster coming soon.'}</p></aside>}
    </div></section>
    {event.clubEvent?.results && <TournamentResults event={event.clubEvent} />}
  </main>
  <Footer />
  <script is:inline type="module" src={scriptUrl('event-archive.js')}></script>
</Base>
<style>
  .page-hero h1{font-size:clamp(2rem,5.5vw,4.8rem);line-height:1.08}
  .original-details{margin-block:2rem}summary{cursor:pointer;padding:.8rem 0;font-weight:800;min-height:44px}.original-details img{max-width:436px;width:100%;height:auto}.announcement{padding:2rem;background:var(--ink);color:#fff;border-top:6px solid var(--azure);min-width:0}.announcement h2{font-family:var(--font-display);font-size:1.8rem;line-height:1.2;margin-block:1.5rem}.announcement p{line-height:1.7;margin-block:1rem}.prize-row{flex-wrap:wrap}.poster-card img{object-fit:contain;height:auto}
</style>
