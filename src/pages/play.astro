---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, events, formatPeso, mapsUrl, weeklySessions } from '../data/site';
import { photos } from '../data/images';

const origin = Astro.site ?? new URL('https://chessunited.pages.dev');
const abs = (path: string) => new URL(path, origin).href;
const nextEvent = events.find((event) => event.status === 'upcoming')!;

const faqs = [
  {
    q: 'Do I need to sign up for Saturday chess?',
    a: 'The weekly sessions aren\'t something you register for on this site. Come to Robinsons Mall La Union on a Saturday between 10:00 AM and 2:00 PM, or to Rovers Coffee between 10:00 AM and 12:00 noon. If you want to check ahead, ask in the club\'s Messenger group.',
  },
  {
    q: 'Can beginners join?',
    a: 'Yes. The club\'s tagline is "chess for everyone." The weekly session is for kids, teens and adults, whether you are learning the moves or playing tournament chess.',
  },
  {
    q: 'What ages play?',
    a: 'Kids, teens and adults. Tournament days split into a Kiddies Division (12 and below) and an Open Division (13 and above).',
  },
  {
    q: 'What should I bring?',
    a: 'Just yourself. If you have a chess board or clock, bring it along; if not, come and watch a few games first.',
  },
  {
    q: 'Is there a fee for the weekly session?',
    a: 'The weekly poster does not list a session fee. Tournament registration fees are published on each event — see the Events page for the exact amounts.',
  },
  {
    q: 'How do I ask a question?',
    a: 'Join the CHESS UNITED – REGION 1 NETWORK group on Messenger. It is the club\'s community channel for schedules, questions and updates.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Weekly play', item: abs('/play/') },
  ],
};
---

<Base
  title="Weekly chess every Saturday — Chess United"
  description="Two weekly chess tables every Saturday in San Fernando, La Union: Robinsons Mall La Union and Rovers Coffee. Kids, teens and adults welcome."
  jsonLd={[faqJsonLd, breadcrumbJsonLd]}
>
  <Header />

  <main id="main">
    <header class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Weekly chess</p>
        <h1>Every Saturday.<br />Your move.</h1>
        <p class="lede">
          Chess United runs two weekly tables in San Fernando: a long afternoon session at
          Robinsons Mall La Union and a morning session at Rovers Coffee. Kids, teens and adults
          are welcome at both — bring a board if you have one.
        </p>
        <div class="page-hero-meta">
          <span><Icon name="calendar" size={15} /> Every Saturday</span>
          <span><Icon name="clock" size={15} /> 10 AM start at both tables</span>
          <span><Icon name="pin" size={15} /> Robinsons Mall · Rovers Coffee</span>
        </div>
      </div>
    </header>

    <section class="section" aria-labelledby="ritual-title">
      <div class="wrap about-split">
        <div class="about-photo reveal">
          <img
            src={photos.hall.src}
            srcset={photos.hall.srcset}
            sizes="(max-width: 980px) 92vw, 48vw"
            width={photos.hall.width}
            height={photos.hall.height}
            alt={photos.hall.alt}
            loading="lazy"
            decoding="async"
          />
          <span class="caption">Tournament 1.0 · Rovers Coffee</span>
        </div>

        <div>
          <p class="eyebrow">The weekly ritual</p>
          <h2 id="ritual-title" class="display-md">One table. All comers.</h2>
          <p class="lede">
            The Saturday session is the club's front door: a table in the mall, a clock, and
            whoever wants to play. Some come to prepare for the next tournament; others come to
            learn the moves. Everyone starts somewhere.
          </p>

          <ul class="checklist mt-2">
            <li><Icon name="check" size={17} /> Kids, teens and adults</li>
            <li><Icon name="check" size={17} /> Casual games and competitive games</li>
            <li><Icon name="check" size={17} /> A regular place to play, tournament or not</li>
            <li><Icon name="check" size={17} /> Same time, same place, every week</li>
          </ul>

          <div class="mt-2 badge-row">
            <span class="badge">Open session</span>
            <span class="badge">Robinsons Mall La Union</span>
            <span class="badge">Rovers Coffee</span>
            <span class="badge">Both start 10 AM</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--paper" aria-labelledby="first-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Your first Saturday</p>
            <h2 id="first-title">Three moves to start.</h2>
          </div>
          <p class="lede">
            Here's a simple way to start.
          </p>
        </div>

        <div class="value-grid">
          <article class="value-card reveal">
            <p class="value-num">01 / Show up</p>
            <h3>Pick a table.</h3>
            <p>
              The mall session runs at Robinsons La Union from 10 AM to 2 PM. The morning session
              runs at Rovers Coffee from 10 AM to noon. Both start at 10.
            </p>
          </article>
          <article class="value-card reveal">
            <p class="value-num">02 / Say hello</p>
            <h3>Find the tables.</h3>
            <p>
              Look for the chess boards and introduce yourself. Ask for a game and see who's
              ready to play.
            </p>
          </article>
          <article class="value-card reveal">
            <p class="value-num">03 / Play</p>
            <h3>Sit down and start.</h3>
            <p>
              Shake hands, set the clock if there is one, and play. New to timed chess? Tell your
              opponent before the clock starts.
            </p>
          </article>
        </div>

        <div class="mt-3 badge-row">
          <a class="text-link" href={mapsUrl(weeklySessions[0].mapsQuery)} target="_blank" rel="noopener">
            Robinsons Mall La Union in Maps <Icon name="external" size={14} />
          </a>
          <a class="text-link" href={mapsUrl(weeklySessions[1].mapsQuery)} target="_blank" rel="noopener">
            Rovers Coffee in Maps <Icon name="external" size={14} />
          </a>
        </div>
      </div>
    </section>

    <section class="weekly section" aria-labelledby="schedule-title">
      <div class="wrap weekly-inner">
        <div class="weekly-copy">
          <p class="eyebrow eyebrow--light">The details</p>
          <h2 id="schedule-title" class="display-lg">Two tables.<br />Pick your Saturday.</h2>
          <p>
            Both sessions run every Saturday and start at 10 AM. The mall table goes all afternoon;
            the coffee shop table wraps at noon. Bring a friend, bring a board if you have one, or
            just bring your curiosity.
          </p>
          <div class="weekly-actions">
            <a class="btn" href={site.groupUrl} target="_blank" rel="noopener">
              Join the group <Icon name="external" size={15} />
            </a>
            <a class="text-link" href="/visit/">
              Venue details <Icon name="arrow" size={14} class="arrow" />
            </a>
          </div>
        </div>

        <div class="schedule-stack">
          {weeklySessions.map((session, i) => (
            <div class:list={['schedule-card', 'reveal', { 'schedule-card--alt': i > 0 }]}>
              <div class="schedule-card-head">
                <strong>{session.venue}</strong>
                <span class="schedule-badge">Open session</span>
              </div>
              <dl>
                <div class="schedule-row">
                  <Icon name="calendar" size={18} />
                  <dt>When</dt>
                  <dd>{session.when}</dd>
                </div>
                <div class="schedule-row">
                  <Icon name="clock" size={18} />
                  <dt>Time</dt>
                  <dd>{session.time}</dd>
                </div>
                <div class="schedule-row">
                  <Icon name="pin" size={18} />
                  <dt>Where</dt>
                  <dd>{session.venue}<span>{session.address}</span></dd>
                </div>
                <div class="schedule-row">
                  <Icon name="users" size={18} />
                  <dt>Who</dt>
                  <dd>Kids, teens &amp; adults<span>First-timers welcome</span></dd>
                </div>
              </dl>
              <a class="text-link" href={mapsUrl(session.mapsQuery)} target="_blank" rel="noopener">
                Open in Maps <Icon name="external" size={14} />
              </a>
              <figure class="schedule-poster">
                <img
                  src={session.poster}
                  width={session.posterWidth}
                  height={session.posterHeight}
                  loading="lazy"
                  decoding="async"
                  alt={`Official Chess United weekly chess poster for the ${session.venue} session, ${session.when} from ${session.time}.`}
                />
                <figcaption>Club poster · {session.venue}</figcaption>
              </figure>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="track-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">The tournament track</p>
            <h2 id="track-title">When you're ready for the clock.</h2>
          </div>
          <p class="lede">
            Saturday chess is the weekly habit. Tournament day is the step up — with divisions,
            prizes and a tournament hall.
          </p>
        </div>

        <div class="division-grid">
          <article class="division division--kiddies reveal">
            <div class="division-top">
              <p class="division-label">Kiddies division</p>
              <p class="division-age">12<span>&amp; below</span></p>
            </div>
            <div class="division-body">
              <h3>Young players, own bracket.</h3>
              <p>
                Tournament 2.0 pays ₱3,000 to the kiddies champion, with prizes down to 10th place.
              </p>
              <p class="division-prize">
                <Icon name="trophy" size={20} />
                <span><strong>{formatPeso(300)}</strong> registration</span>
              </p>
            </div>
          </article>

          <article class="division division--open reveal">
            <div class="division-top">
              <p class="division-label">Open division</p>
              <p class="division-age">13<span>&amp; above</span></p>
            </div>
            <div class="division-body">
              <h3>The main board.</h3>
              <p>
                Tournament 2.0 pays ₱5,000 to the open champion, with a Top Lady and Top Senior
                prize.
              </p>
              <p class="division-prize">
                <Icon name="trophy" size={20} />
                <span><strong>{formatPeso(350)}</strong> registration</span>
              </p>
            </div>
          </article>
        </div>

        <div class="past-band">
          <p>
            <strong>Next tournament:</strong> {nextEvent.name} · {nextEvent.dateLabel} · {nextEvent.venueShort}
          </p>
          <a class="text-link" href={`/events/#${nextEvent.slug}`}>
            Event details <Icon name="arrow" size={14} class="arrow" />
          </a>
        </div>
      </div>
    </section>

    <section class="section section--paper" aria-labelledby="faq-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Good to know</p>
            <h2 id="faq-title">Questions, answered.</h2>
          </div>
          <p class="lede">
            Still unsure? The community group is the place to ask a real person.
          </p>
        </div>

        <div class="faq">
          {faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <div class="faq-answer"><p>{item.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="play-cta">
      <div class="wrap cta-inner">
        <div>
          <h2 id="play-cta" class="display-lg">See you Saturday.</h2>
          <p>10 AM at Robinsons Mall La Union, or 10 AM at Rovers Coffee. Bring a friend.</p>
        </div>
        <div class="cta-actions">
          <a class="btn" href={site.groupUrl} target="_blank" rel="noopener">
            Join the Messenger group <Icon name="external" size={15} />
          </a>
          <a class="btn btn--light" href="/visit/">Find the tables</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
