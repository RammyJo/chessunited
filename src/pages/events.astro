---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, events, upcomingEvents, formatPeso, gcash, mapsUrl } from '../data/site';
import { photos } from '../data/images';

const origin = Astro.site ?? new URL('https://chessunited.pages.dev');
const abs = (path: string) => new URL(path, origin).href;
const past = events.find((event) => event.status === 'past')!;

/* Held as a string so Astro does not read `{{…}}` in markup as a JS expression.
   forms.js fills these tokens from the JSON the API returns. */
const entryTemplate = `
  <h3>Entry received.</h3>
  <p>
    <strong>{{registration.fullName}}</strong> — {{registration.eventName}},
    {{registration.division}}.
  </p>
  <p>Entry fee: ₱{{registration.amount}}</p>
  <p>
    Reference {{registration.gcashRef}} is saved against this entry. The club
    confirms your slot once the payment is matched, so keep the receipt until then.
  </p>
`;
const remainingLabel =
  upcomingEvents.length === 0
    ? 'Season complete'
    : upcomingEvents.length === 1
      ? 'One event remaining'
      : `${upcomingEvents.length} events remaining`;

const eventJsonLd = upcomingEvents.map((event) => ({
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: event.name,
  description: `${event.name} at ${event.venue}, San Fernando City, La Union. Open Division (13 & above) and Kiddies Division (12 & below).`,
  startDate: `${event.date}T${event.start}:00+08:00`,
  endDate: `${event.date}T${event.end}:00+08:00`,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  url: abs(`/events/#${event.slug}`),
  image: abs(event.poster ?? '/images/og.jpg'),
  location: {
    '@type': 'Place',
    name: event.venue,
    address: {
      '@type': 'PostalAddress',
      ...(event.slug === 'super-mario-cup'
        ? { streetAddress: 'New Government Center, Barangay Sevilla' }
        : {}),
      addressLocality: 'San Fernando City',
      addressRegion: 'La Union',
      addressCountry: 'PH',
    },
  },
  organizer: { '@type': 'Organization', name: site.name, url: abs('/') },
  offers: event.divisions.map((division) => ({
    '@type': 'Offer',
    name: division.name,
    price: division.fee,
    priceCurrency: 'PHP',
    url: abs(`/events/#${event.slug}`),
  })),
}));

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Events', item: abs('/events/') },
  ],
};
---

<Base
  title="Tournaments & events — Chess United"
  description="Chess United Tournament 2.0 on 7 November 2026 at Robinsons Mall La Union, plus the Super Mario Cup on 5 December. Divisions, prizes, venues, fees."
  jsonLd={[...eventJsonLd, breadcrumbJsonLd]}
>
  <Header />

  <main id="main">
    <header class="page-hero">
      <div class="wrap">
        <p class="eyebrow">2026 season</p>
        <h1>Tournament days.</h1>
        <p class="lede">
          Age divisions, cash prizes and a hall of boards. Here's what's coming up — and what
          just happened.
        </p>
        <div class="page-hero-meta">
          <span><Icon name="trophy" size={15} /> Open + Kiddies</span>
          <span><Icon name="pin" size={15} /> San Fernando City</span>
          <span><Icon name="calendar" size={15} /> {remainingLabel}</span>
        </div>
      </div>
    </header>

    {upcomingEvents.map((event) => (
      <section class="section" id={event.slug} aria-labelledby={`${event.slug}-title`}>
        <div class="wrap event-detail">
          <div>
            <div class="event-detail-head">
              <span class="status-pill">{event.kicker}</span>
              <span class="badge">Open 13+</span>
              <span class="badge">Kiddies 12 &amp; below</span>
            </div>

            <h2 id={`${event.slug}-title`}>{event.name}</h2>
            <p class="event-big-date">{event.dateLabel} <span>{event.timeLabel}</span></p>

            <dl class="fact-grid">
              <div class="fact">
                <dt>Date</dt>
                <dd>{event.dateLabel}<span>{event.timeLabel}</span></dd>
              </div>
              <div class="fact">
                <dt>Venue</dt>
                <dd>{event.venue}<span>{event.address}</span></dd>
              </div>
              <div class="fact">
                <dt>Divisions</dt>
                <dd>Open &amp; Kiddies<span>13 &amp; above · 12 &amp; below</span></dd>
              </div>
            </dl>

            <div class="prize-block">
              {event.divisions.map((division) => (
                <>
                  <h3>
                    {division.name}
                    <span>{division.ages} · {formatPeso(division.fee)} registration</span>
                  </h3>
                  <div class="prize-table">
                    {division.prizes.map((prize, index) => (
                      <div class={`prize-row${index === 0 ? ' prize-row--top' : ''}`}>
                        <span class="place">{prize.place}</span>
                        {prize.note && <span class="note">{prize.note}</span>}
                        <span class="dots" aria-hidden="true"></span>
                        <span class="amount">{formatPeso(prize.amount)}</span>
                      </div>
                    ))}
                  </div>
                </>
              ))}
            </div>

            <div class="fee-banner">
              <strong>Registration</strong>
              <span>
                {event.divisions.map((division) => `${division.name}: ${formatPeso(division.fee)}`).join('  ·  ')}
              </span>
            </div>

            {event.note && <p class="event-note">{event.note}</p>}

            <div class="event-actions">
              <a class="btn" href="#register">
                <Icon name="trophy" size={15} /> Enter online
              </a>
              <a class="btn btn--ghost" href={site.groupUrl} target="_blank" rel="noopener">
                Ask in the group
                <Icon name="external" size={15} />
              </a>
              {event.ics && (
                <a class="btn btn--ghost" href={event.ics} download>
                  <Icon name="download" size={16} /> Add to calendar
                </a>
              )}
              <a class="btn btn--ghost" href={mapsUrl(event.mapsQuery)} target="_blank" rel="noopener">
                <Icon name="pin" size={16} /> Open in Maps
              </a>
              <button
                class="btn btn--ghost"
                type="button"
                data-copy={`${event.name} — ${event.dateLabel}, ${event.timeLabel}, ${event.venue}. ${event.divisions.map((d) => `${d.name} (${d.ages}) registration ${formatPeso(d.fee)}`).join('; ')}. Details: ${abs(`/events/#${event.slug}`)}`}
              >
                <Icon name="share" size={16} /> <span data-copy-label>Copy details</span>
              </button>
            </div>

            <p class="event-note">
              Event details are reproduced from the club's official posters. Venue, schedule and
              availability can change — the community group carries the latest word.
            </p>
          </div>

          <figure class="poster-card">
            <img
              src={event.poster}
              width={event.posterWidth ?? 900}
              height={event.posterHeight ?? 675}
              alt={`Official poster for ${event.name}, ${event.dateLabel} at ${event.venue}.`}
              loading="lazy"
              decoding="async"
            />
            <figcaption>Official event poster · {event.month} {event.year}</figcaption>
          </figure>
        </div>
      </section>
    ))}

    <section class="section section--paper" id="register" aria-labelledby="register-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Register online</p>
            <h2 id="register-title">Enter a tournament.</h2>
          </div>
          <p class="lede">
            Pick your tournament and division, scan the club's GCash QR on that event's poster, pay
            the entry fee, then paste the {gcash.referenceLength}-digit reference number from your
            receipt. A club officer matches every reference by hand before your slot is confirmed.
          </p>
        </div>

        <div class="entry-grid">
          {upcomingEvents.map((event) => (
            <div data-form-shell>
              <form class="form-card" data-api="/api/registrations">
                <h3>{event.shortName}</h3>
                <p class="lede">{event.dateLabel} · {event.venue}</p>

                <input type="hidden" name="eventSlug" value={event.slug} />

                <div class="form-grid">
                  <div class="field">
                    <label for={`r-${event.slug}-name`}>Player's full name</label>
                    <input
                      id={`r-${event.slug}-name`}
                      name="fullName"
                      required
                      minlength="3"
                      maxlength="120"
                      autocomplete="name"
                    />
                    <p class="field-error" data-error-for="fullName" hidden></p>
                  </div>

                  <div class="field">
                    <label for={`r-${event.slug}-division`}>Division</label>
                    <select id={`r-${event.slug}-division`} name="division" required>
                      {event.divisions.map((division) => (
                        <option value={division.name}>
                          {division.name} — {division.ages} · {formatPeso(division.fee)} entry
                        </option>
                      ))}
                    </select>
                    <p class="field-error" data-error-for="division" hidden></p>
                  </div>

                  <div class="field">
                    <label for={`r-${event.slug}-email`}>Email</label>
                    <input
                      id={`r-${event.slug}-email`}
                      name="email"
                      type="email"
                      required
                      autocomplete="email"
                    />
                    <p class="field-error" data-error-for="email" hidden></p>
                  </div>

                  <div class="field">
                    <label for={`r-${event.slug}-phone`}>Mobile number</label>
                    <input
                      id={`r-${event.slug}-phone`}
                      name="phone"
                      required
                      inputmode="tel"
                      placeholder="09171234567"
                      autocomplete="tel"
                    />
                    <p class="field-error" data-error-for="phone" hidden></p>
                  </div>

                  <div class="field">
                    <label for={`r-${event.slug}-club`}>Club <span class="hint">optional</span></label>
                    <input id={`r-${event.slug}-club`} name="club" maxlength="120" />
                  </div>

                  <div class="field">
                    <label for={`r-${event.slug}-member`}>
                      Member number <span class="hint">optional</span>
                    </label>
                    <input
                      id={`r-${event.slug}-member`}
                      name="memberNo"
                      maxlength="20"
                      placeholder="CU-2026-0000"
                    />
                  </div>

                  <div class="field field--wide">
                    <label for={`r-${event.slug}-ref`}>GCash reference number</label>
                    <input
                      id={`r-${event.slug}-ref`}
                      name="gcashRef"
                      required
                      inputmode="numeric"
                      maxlength="20"
                      placeholder={`${gcash.referenceLength} digits`}
                    />
                    <p class="field-error" data-error-for="gcashRef" hidden></p>
                  </div>

                  <div class="field field--wide">
                    <label for={`r-${event.slug}-notes`}>
                      Anything the club should know <span class="hint">optional</span>
                    </label>
                    <textarea
                      id={`r-${event.slug}-notes`}
                      name="notes"
                      maxlength="400"
                      placeholder="School, age, or a note about the entry."
                    ></textarea>
                  </div>
                </div>

                <div class="pay-box mt-3">
                  <strong>Paying by GCash</strong>
                  <ol>
                    <li>Scan the GCash QR printed on the {event.shortName} poster.</li>
                    <li>Pay the entry fee for the division you chose — the amount is in the list above.</li>
                    <li>Copy the {gcash.referenceLength}-digit reference number and paste it in the form.</li>
                  </ol>
                </div>

                <p class="form-status" data-form-status hidden></p>

                <div class="form-actions">
                  <button class="btn" type="submit" data-busy="Sending…">
                    <Icon name="check" size={16} /> Send my entry
                  </button>
                  <a class="btn btn--ghost" href="/membership/">Get a member number</a>
                </div>
              </form>

              <div class="form-success" data-success hidden>
                <template data-success-template set:html={entryTemplate}></template>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--paper" aria-labelledby="weekly-note-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Between tournaments</p>
            <h2 id="weekly-note-title">The weekly tables.</h2>
          </div>
          <p class="lede">
            Tournament day is the loud one. The weekly sessions happen every Saturday — at
            Robinsons Mall La Union and at Rovers Coffee.
          </p>
        </div>

        <div class="mini-event">
          <p class="mini-date">SAT<span>Weekly</span></p>
          <div>
            <h3>Open chess at Robinsons Mall La Union and Rovers Coffee</h3>
            <p>
              Every Saturday · Robinsons 10:00 AM – 2:00 PM · Rovers 10:00 AM – noon · kids, teens
              and adults
            </p>
          </div>
          <a class="text-link" href="/visit/">Weekly play <Icon name="arrow" size={14} class="arrow" /></a>
        </div>
      </div>
    </section>

    <section class="section" id="tournament-1-0" aria-labelledby="past-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">In the books</p>
            <h2 id="past-title">Tournament 1.0.</h2>
          </div>
          <p class="lede">
            The club's first tournament day brought the kiddies bracket and the open division to
            Rovers Coffee. Here's the recap.
          </p>
        </div>

        <div class="event-detail" style="border-bottom:0;padding-top:0">
          <div>
            <div class="event-detail-head">
              <span class="status-pill status-pill--past"><Icon name="check" size={12} /> Completed</span>
              <span class="badge">17 October 2026</span>
            </div>
            <h2>{past.name}</h2>
            <p class="event-big-date">{past.dateLabel} <span>{past.timeLabel}</span></p>

            <dl class="fact-grid">
              <div class="fact">
                <dt>Venue</dt>
                <dd>Rovers Coffee<span>Carlatan, San Fernando City</span></dd>
              </div>
              <div class="fact">
                <dt>Format</dt>
                <dd>Open + Kiddies<span>Two three-hour match blocks</span></dd>
              </div>
              <div class="fact">
                <dt>Status</dt>
                <dd>Completed<span>Photos in the gallery</span></dd>
              </div>
            </dl>

            <div class="past-band">
              <p><strong>Relive the day.</strong> Tables, medals and the crew — all in the gallery.</p>
              <a class="text-link" href="/gallery/">Open the gallery <Icon name="arrow" size={14} class="arrow" /></a>
            </div>

            <div class="mt-2 badge-row" aria-label="Tournament 1.0 facts">
              <span class="badge">₱3,000 open champion</span>
              <span class="badge">₱2,000 kiddies champion</span>
              <span class="badge">Medals for the podium</span>
            </div>
          </div>

          <figure class="poster-card">
            <img
              src={past.poster}
              width={past.posterWidth ?? 900}
              height={past.posterHeight ?? 675}
              alt="Official poster for Chess United Tournament 1.0 on 17 October 2026 at Rovers Coffee."
              loading="lazy"
              decoding="async"
            />
            <figcaption>Official event poster · October 2026</figcaption>
          </figure>
        </div>

        <div class="division-grid mt-3" style="align-items:start">
          <figure style="margin:0;border:2px solid var(--ink);overflow:hidden">
            <img
              src={photos.medals.src}
              srcset={photos.medals.srcset}
              sizes="(max-width: 760px) 92vw, 45vw"
              width={photos.medals.width}
              height={photos.medals.height}
              alt={photos.medals.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <figure style="margin:0;border:2px solid var(--ink);overflow:hidden">
            <img
              src={photos.medalist.src}
              srcset={photos.medalist.srcset}
              sizes="(max-width: 760px) 92vw, 45vw"
              width={photos.medalist.width}
              height={photos.medalist.height}
              alt={photos.medalist.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>

        {past.results && (
          <div class="results" id="tournament-1-0-results">
            <div class="section-head">
              <div>
                <p class="eyebrow">The leaderboard</p>
                <h3 class="display-md">Top 10 in both divisions.</h3>
              </div>
              <p class="lede">
                Final standings exactly as the club published them after Tournament 1.0.
              </p>
            </div>

            <div class="results-grid">
              {past.results.map((board) => (
                <article class="result-board reveal">
                  <header class="result-head">
                    <h4>{board.division}</h4>
                    <span>{board.ages}</span>
                  </header>
                  <ol class="result-list">
                    {board.places.map((place) => (
                      <li class:list={{ 'is-podium': place.rank <= 3 }}>
                        <span class="rank">{place.rank}</span>
                        <span class="who">{place.name}</span>
                        {place.rank === 1 && <span class="tag-line">Champion</span>}
                        {place.rank === 2 && <span class="tag-line">2nd place</span>}
                        {place.rank === 3 && <span class="tag-line">3rd place</span>}
                      </li>
                    ))}
                  </ol>
                  <figure class="result-poster">
                    <img
                      src={board.poster}
                      width={board.posterWidth}
                      height={board.posterHeight}
                      alt={`Official Chess United Tournament 1.0 Top 10 results poster for the ${board.division}, ${board.ages}.`}
                      loading="lazy"
                      decoding="async"
                    />
                    <figcaption>Official results poster · {board.division}</figcaption>
                  </figure>
                </article>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <section class="cta-band" aria-labelledby="events-cta">
      <div class="wrap cta-inner">
        <div>
          <h2 id="events-cta" class="display-lg">Bring your board face.</h2>
          <p>Enter online with your GCash reference, or ask the club in the group.</p>
        </div>
        <div class="cta-actions">
          <a class="btn" href="#register">
            Enter a tournament
          </a>
          <a class="btn btn--light" href="/visit/">Venue details</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
