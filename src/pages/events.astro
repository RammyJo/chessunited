---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, events, upcomingEvents, formatPeso, mapsUrl } from '../data/site';
import { photos } from '../data/images';

const origin = Astro.site ?? new URL('https://chessunited.pages.dev');
const abs = (path: string) => new URL(path, origin).href;
const past = events.find((event) => event.status === 'past')!;
const remainingLabel =
  upcomingEvents.length === 0
    ? 'Season complete'
    : upcomingEvents.length === 1
      ? 'One event remaining'
      : `${upcomingEvents.length} events remaining`;

const eventJsonLd = upcomingEvents.map((event) => ({
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: event.name,
  description: `${event.name} at ${event.venue}, San Fernando City, La Union. Open Division (13 & above) and Kiddies Division (12 & below).`,
  startDate: `${event.date}T${event.start}:00+08:00`,
  endDate: `${event.date}T${event.end}:00+08:00`,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  url: abs(`/events/#${event.slug}`),
  image: abs(event.poster ?? '/images/og.jpg'),
  location: {
    '@type': 'Place',
    name: event.venue,
    address: {
      '@type': 'PostalAddress',
      ...(event.slug === 'super-mario-cup'
        ? { streetAddress: 'New Government Center, Barangay Sevilla' }
        : {}),
      addressLocality: 'San Fernando City',
      addressRegion: 'La Union',
      addressCountry: 'PH',
    },
  },
  organizer: { '@type': 'Organization', name: site.name, url: abs('/') },
  offers: event.divisions.map((division) => ({
    '@type': 'Offer',
    name: division.name,
    price: division.fee,
    priceCurrency: 'PHP',
    url: abs(`/events/#${event.slug}`),
  })),
}));

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Events', item: abs('/events/') },
  ],
};
---

<Base
  title="Tournaments & events — Chess United"
  description="Chess United Tournament 2.0 on 7 November 2026 at Manna Mall, and the Ortega Super Mario Cup on 5 December 2026. Divisions, prizes, venues and registration fees."
  jsonLd={[...eventJsonLd, breadcrumbJsonLd]}
>
  <Header />

  <main id="main">
    <header class="page-hero">
      <div class="wrap">
        <p class="eyebrow">2026 season</p>
        <h1>Tournament days.</h1>
        <p class="lede">
          Age divisions, cash prizes and a hall of boards. Here's what's coming up — and what
          just happened.
        </p>
        <div class="page-hero-meta">
          <span><Icon name="trophy" size={15} /> Open + Kiddies</span>
          <span><Icon name="pin" size={15} /> San Fernando City</span>
          <span><Icon name="calendar" size={15} /> {remainingLabel}</span>
        </div>
      </div>
    </header>

    {upcomingEvents.map((event) => (
      <section class="section" id={event.slug} aria-labelledby={`${event.slug}-title`}>
        <div class="wrap event-detail">
          <div>
            <div class="event-detail-head">
              <span class="status-pill">{event.kicker}</span>
              <span class="badge">Open 13+</span>
              <span class="badge">Kiddies 12 &amp; below</span>
            </div>

            <h2 id={`${event.slug}-title`}>{event.name}</h2>
            <p class="event-big-date">{event.dateLabel} <span>{event.timeLabel}</span></p>

            <dl class="fact-grid">
              <div class="fact">
                <dt>Date</dt>
                <dd>{event.dateLabel}<span>{event.timeLabel}</span></dd>
              </div>
              <div class="fact">
                <dt>Venue</dt>
                <dd>{event.venue}<span>{event.address}</span></dd>
              </div>
              <div class="fact">
                <dt>Divisions</dt>
                <dd>Open &amp; Kiddies<span>13 &amp; above · 12 &amp; below</span></dd>
              </div>
            </dl>

            <div class="prize-block">
              {event.divisions.map((division) => (
                <>
                  <h3>
                    {division.name}
                    <span>{division.ages} · {formatPeso(division.fee)} registration</span>
                  </h3>
                  <div class="prize-table">
                    {division.prizes.map((prize, index) => (
                      <div class={`prize-row${index === 0 ? ' prize-row--top' : ''}`}>
                        <span class="place">{prize.place}</span>
                        {prize.note && <span class="note">{prize.note}</span>}
                        <span class="dots" aria-hidden="true"></span>
                        <span class="amount">{formatPeso(prize.amount)}</span>
                      </div>
                    ))}
                  </div>
                </>
              ))}
            </div>

            <div class="fee-banner">
              <strong>Registration</strong>
              <span>
                {event.divisions.map((division) => `${division.name}: ${formatPeso(division.fee)}`).join('  ·  ')}
              </span>
            </div>

            {event.note && <p class="event-note">{event.note}</p>}

            <div class="event-actions">
              <a class="btn" href={site.groupUrl} target="_blank" rel="noopener">
                Ask about sign-up
                <Icon name="external" size={15} />
              </a>
              {event.ics && (
                <a class="btn btn--ghost" href={event.ics} download>
                  <Icon name="download" size={16} /> Add to calendar
                </a>
              )}
              <a class="btn btn--ghost" href={mapsUrl(event.mapsQuery)} target="_blank" rel="noopener">
                <Icon name="pin" size={16} /> Open in Maps
              </a>
              <button
                class="btn btn--ghost"
                type="button"
                data-copy={`${event.name} — ${event.dateLabel}, ${event.timeLabel}, ${event.venue}. ${event.divisions.map((d) => `${d.name} (${d.ages}) registration ${formatPeso(d.fee)}`).join('; ')}. Details: ${abs(`/events/#${event.slug}`)}`}
              >
                <Icon name="share" size={16} /> <span data-copy-label>Copy details</span>
              </button>
            </div>

            <p class="event-note">
              Event details are reproduced from the club's official posters. Venue, schedule and
              availability can change — the community group carries the latest word.
            </p>
          </div>

          <figure class="poster-card">
            <img
              src={event.poster}
              width={event.posterWidth ?? 900}
              height={event.posterHeight ?? 675}
              alt={`Official poster for ${event.name}, ${event.dateLabel} at ${event.venue}.`}
              loading="lazy"
              decoding="async"
            />
            <figcaption>Official event poster · {event.month} {event.year}</figcaption>
          </figure>
        </div>
      </section>
    ))}

    <section class="section section--paper" aria-labelledby="weekly-note-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Between tournaments</p>
            <h2 id="weekly-note-title">The weekly table.</h2>
          </div>
          <p class="lede">
            Tournament day is the loud one. The weekly club session happens every Saturday at
            Robinsons Mall La Union.
          </p>
        </div>

        <div class="mini-event">
          <p class="mini-date">SAT<span>Weekly</span></p>
          <div>
            <h3>Open chess at Robinsons Mall La Union</h3>
            <p>Every Saturday · 10:00 AM – 2:00 PM · kids, teens and adults</p>
          </div>
          <a class="text-link" href="/play/">Weekly play <Icon name="arrow" size={14} class="arrow" /></a>
        </div>
      </div>
    </section>

    <section class="section" id="tournament-1-0" aria-labelledby="past-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">In the books</p>
            <h2 id="past-title">Tournament 1.0.</h2>
          </div>
          <p class="lede">
            The club's first tournament day brought the kiddies bracket and the open division to
            Rovers Coffee. Here's the recap.
          </p>
        </div>

        <div class="event-detail" style="border-bottom:0;padding-top:0">
          <div>
            <div class="event-detail-head">
              <span class="status-pill status-pill--past"><Icon name="check" size={12} /> Completed</span>
              <span class="badge">17 October 2026</span>
            </div>
            <h2>{past.name}</h2>
            <p class="event-big-date">{past.dateLabel} <span>{past.timeLabel}</span></p>

            <dl class="fact-grid">
              <div class="fact">
                <dt>Venue</dt>
                <dd>Rovers Coffee<span>Carlatan, San Fernando City</span></dd>
              </div>
              <div class="fact">
                <dt>Format</dt>
                <dd>Open + Kiddies<span>Two three-hour match blocks</span></dd>
              </div>
              <div class="fact">
                <dt>Status</dt>
                <dd>Completed<span>Photos in the gallery</span></dd>
              </div>
            </dl>

            <div class="past-band">
              <p><strong>Relive the day.</strong> Tables, medals and the crew — all in the gallery.</p>
              <a class="text-link" href="/gallery/">Open the gallery <Icon name="arrow" size={14} class="arrow" /></a>
            </div>

            <div class="mt-2 badge-row" aria-label="Tournament 1.0 facts">
              <span class="badge">₱3,000 open champion</span>
              <span class="badge">₱2,000 kiddies champion</span>
              <span class="badge">Medals for the podium</span>
            </div>
          </div>

          <figure class="poster-card">
            <img
              src={past.poster}
              width={past.posterWidth ?? 900}
              height={past.posterHeight ?? 675}
              alt="Official poster for Chess United Tournament 1.0 on 17 October 2026 at Rovers Coffee."
              loading="lazy"
              decoding="async"
            />
            <figcaption>Official event poster · October 2026</figcaption>
          </figure>
        </div>

        <div class="division-grid mt-3" style="align-items:start">
          <figure style="margin:0;border:2px solid var(--ink);overflow:hidden">
            <img
              src={photos.medals.src}
              srcset={photos.medals.srcset}
              sizes="(max-width: 760px) 92vw, 45vw"
              width={photos.medals.width}
              height={photos.medals.height}
              alt={photos.medals.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <figure style="margin:0;border:2px solid var(--ink);overflow:hidden">
            <img
              src={photos.medalist.src}
              srcset={photos.medalist.srcset}
              sizes="(max-width: 760px) 92vw, 45vw"
              width={photos.medalist.width}
              height={photos.medalist.height}
              alt={photos.medalist.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="events-cta">
      <div class="wrap cta-inner">
        <div>
          <h2 id="events-cta" class="display-lg">Bring your board face.</h2>
          <p>Sign-up is handled by the club — ask in the group for the current process.</p>
        </div>
        <div class="cta-actions">
          <a class="btn" href={site.groupUrl} target="_blank" rel="noopener">
            Join the group <Icon name="external" size={15} />
          </a>
          <a class="btn btn--light" href="/visit/">Venue details</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
