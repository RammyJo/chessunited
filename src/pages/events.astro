---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import EventArchive from '../components/EventArchive.astro';
import TournamentEntryForms from '../components/TournamentEntryForms.astro';
import AddToCalendar from '../components/AddToCalendar.astro';
import { site, saturdayEvent, saturdayJsonLd, mapsUrl } from '../data/site';
import { eventArchive, eventPath } from '../data/event-archive';
import { scriptUrl } from '../lib/assets';
const origin = Astro.site ?? new URL('https://chessunitedglobal.com');
const abs = (path: string) => new URL(path, origin).href;
const archiveSchema = {
  '@context':'https://schema.org','@type':'CollectionPage',name:'Elyu chess events archive',url:abs('/events/'),
  mainEntity:{'@type':'ItemList',itemListElement:eventArchive.map((event,index)=>({'@type':'ListItem',position:index+1,name:event.name,url:abs(eventPath(event))}))},
};
---
<Base title="Elyu chess events & permanent archive — Chess United" description="Explore present and past chess events in La Union. Tournament posters, dates, coaching visits and published results stay in the permanent Elyu archive." jsonLd={[archiveSchema,saturdayJsonLd(origin.href)]}>
  <Header />
  <main id="main">
    <header class="page-hero"><div class="wrap">
      <p class="eyebrow">La Union · The chess calendar</p><h1>Elyu chess events.</h1>
      <p class="lede">Find your next tournament and revisit the games that came before. Chess United 1.0, 2.0, 3.0 and events across La Union, together in one permanent archive.</p>
      <nav class="event-actions" aria-label="Event sections"><a class="btn" href="#present-events">Present Events <Icon name="arrow" size={16} /></a><a class="btn btn--ghost" href="#past-events">Past Events</a><a class="text-link" href="#saturday-chess">Weekly chess <Icon name="calendar" size={15} /></a></nav>
    </div></header>
    <EventArchive />
    <section class="section" id="saturday-chess" aria-labelledby="saturday-title"><div class="wrap weekly-summary">
      <div><p class="eyebrow">The standing invitation</p><h2 id="saturday-title">Saturday chess</h2><p class="lede">SM City La Union · Every Saturday, 10 AM–2 PM. Kids, teens, adults and beginners are welcome.</p>
        <div class="event-actions"><a class="btn" href="/visit/">Plan your visit <Icon name="arrow" size={16} /></a><a class="text-link" href={mapsUrl(saturdayEvent.mapsQuery)} target="_blank" rel="noopener noreferrer">Find the tables <Icon name="pin" size={15} /></a></div>
        <AddToCalendar event={saturdayEvent} link={abs('/events/#saturday-chess')} />
      </div>
      <aside class="weekly-note"><h3>Have an Elyu event to add?</h3><p>Send the club an official poster, date, venue and organiser’s contact. Its event page will stay in the archive.</p><a class="text-link" href={site.groupUrl} target="_blank" rel="noopener noreferrer">Share it with the club <Icon name="external" size={15} /></a></aside>
    </div></section>
    <TournamentEntryForms />
  </main>
  <Footer />
  <script is:inline type="module" src={scriptUrl('event-archive.js')}></script>
</Base>
<style>
  .weekly-summary{display:grid;grid-template-columns:1.5fr 1fr;gap:2rem;align-items:start}.weekly-note{padding:1.5rem;border:2px solid var(--ink);background:var(--card)}h3{font-family:var(--font-display);font-size:1.2rem;line-height:1.4;margin-bottom:1rem}.weekly-note p{font-size:.9rem;line-height:1.7;margin-bottom:1.5rem}
  @media(max-width:760px){.weekly-summary{grid-template-columns:1fr}}
</style>
